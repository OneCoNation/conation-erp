2026-02-05 03:26:25 DEBUG   ::1                8940         sql=INSERT INTO llx_const(name, value, type, visible, note, entity) VALUES ('MAIN_IHM_CUSTOM_CSS', '/* ==========================================================================\r\n THEME: MODERN ENTERPRISE ERP (ODOO/FIORI STYLE)\r\n Role: Senior Frontend Engineer\r\n Concept: Elevation, Softness, & Whitespace\r\n ========================================================================== */\r\n\r\n/* 1. TYPOGRAPHY SYSTEM \r\n Menggunakan \'Plus Jakarta Sans\' untuk nuansa geometris modern namun sangat terbaca.\r\n*/\r\n@import url(\'https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap\');\r\n\r\n:root {\r\n /* Color Palette - Professional & Vibrant */\r\n --font-stack: \'Plus Jakarta Sans\', ui-sans-serif, system-ui, -apple-system, sans-serif;\r\n --primary: #6366f1; /* Indigo 500 - Ganti sesuai branding perusahaan */\r\n --primary-hover: #4f46e5;\r\n --bg-body: #f8fafc; /* Slate 50 - Off-white untuk mengurangi eye strain */\r\n --bg-surface: #ffffff;\r\n --text-main: #1e293b; /* Slate 800 */\r\n --text-muted: #64748b; /* Slate 500 */\r\n \r\n /* Elevation & Depth (Layered Shadows) */\r\n --shadow-sm: 0 1px 2px 0 rgb(0 0 0 / 0.05);\r\n --shadow-md: 0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1);\r\n --shadow-lg: 0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1);\r\n \r\n /* Layout Softness */\r\n --radius-sm: 8px;\r\n --radius-md: 12px;\r\n --radius-lg: 16px;\r\n \r\n /* Transitions */\r\n --ease-out: cubic-bezier(0.4, 0, 0.2, 1);\r\n}\r\n\r\n/* 2. GLOBAL RESET & BASE STYLES */\r\nbody, h1, h2, h3, h4, h5, h6, .fiche, .liste, div, span, p {\r\n font-family: var(--font-stack) !important;\r\n color: var(--text-main);\r\n}\r\n\r\nbody {\r\n background-color: var(--bg-body) !important;\r\n line-height: 1.6;\r\n letter-spacing: 0.01em; /* Sedikit tracking untuk legibility */\r\n}\r\n\r\n/* Menghilangkan background abu-abu kaku Dolibarr lama */\r\n.fiche {\r\n margin-top: 20px !important;\r\n border: none !important;\r\n}\r\n\r\n/* 3. LAYOUT & CARDS (The \"Floating\" Effect) */\r\n/* Mengubah container utama menjadi Card modern */\r\ndiv.fiche > table, \r\ndiv.tabBar, \r\ndiv.div-table-responsive {\r\n background: var(--bg-surface);\r\n border-radius: var(--radius-lg);\r\n box-shadow: var(--shadow-md);\r\n border: 1px solid rgba(226, 232, 240, 0.8); /* Slate 200 sangat tipis */\r\n margin-bottom: 24px !important;\r\n padding: 24px !important;\r\n transition: transform 0.3s var(--ease-out), box-shadow 0.3s var(--ease-out);\r\n}\r\n\r\n/* Interactive Micro-interaction: Lift effect on hover */\r\ndiv.fiche > table:hover,\r\ndiv.div-table-responsive:hover {\r\n transform: translateY(-2px);\r\n box-shadow: var(--shadow-lg);\r\n}\r\n\r\n/* Sidebar (Left Menu) */\r\ndiv.vmenu {\r\n border-right: none !important;\r\n background: transparent !important;\r\n}\r\n\r\n.blockvmenu {\r\n background: var(--bg-surface);\r\n border: none !important;\r\n border-radius: var(--radius-md);\r\n box-shadow: var(--shadow-sm);\r\n margin-bottom: 16px !important;\r\n overflow: hidden;\r\n}\r\n\r\n.menu_titre {\r\n font-weight: 700 !important;\r\n text-transform: uppercase;\r\n letter-spacing: 0.05em;\r\n font-size: 0.75rem !important;\r\n color: var(--text-muted) !important;\r\n background: transparent !important;\r\n padding: 16px 20px !important;\r\n border-bottom: 1px solid #f1f5f9 !important;\r\n}\r\n\r\n.vmenu .menu_contenu {\r\n padding: 8px 0 !important;\r\n}\r\n\r\n/* Sidebar Links */\r\na.vmenu {\r\n padding: 10px 20px !important;\r\n border-radius: 0 !important;\r\n transition: all 0.2s var(--ease-out);\r\n color: var(--text-main) !important;\r\n font-weight: 500 !important;\r\n}\r\n\r\na.vmenu:hover, a.vmenu:focus {\r\n background-color: #f1f5f9 !important; /* Slate 100 */\r\n padding-left: 28px !important; /* Micro-movement feedback */\r\n color: var(--primary) !important;\r\n}\r\n\r\n/* 4. MODERN TABLE UI (ODOO LIST VIEW STYLE) */\r\n/* Hapus grid kaku */\r\n.liste {\r\n border-collapse: separate !important;\r\n border-spacing: 0 !important;\r\n border: none !important;\r\n width: 100% !important;\r\n}\r\n\r\n/* Header Table */\r\n.liste_titre {\r\n background: #f8fafc !important; /* Slate 50 */\r\n color: var(--text-muted) !important;\r\n font-weight: 600 !important;\r\n text-transform: uppercase;\r\n font-size: 0.75rem !important;\r\n letter-spacing: 0.05em;\r\n padding: 16px !important;\r\n border-bottom: 2px solid #e2e8f0 !important;\r\n border-top: none !important;\r\n}\r\n\r\n/* Baris Data */\r\n.tagtr {\r\n background: #ffffff !important;\r\n transition: background-color 0.2s var(--ease-out);\r\n}\r\n\r\n.tagtr td {\r\n border-bottom: 1px solid #f1f5f9 !important; /* Separator sangat halus */\r\n padding: 16px !important; /* Whitespace management */\r\n vertical-align: middle !important;\r\n}\r\n\r\n/* Hover Effect pada Baris */\r\n.tagtr:hover {\r\n background-color: #f8fafc !important; /* Highlight sangat lembut */\r\n cursor: pointer;\r\n}\r\n\r\n/* Menghilangkan garis vertikal (Vertical Borders) */\r\n.liste td, .liste th {\r\n border-left: none !important;\r\n border-right: none !important;\r\n}\r\n\r\n/* 5. INTERACTIVE ELEMENTS (BUTTONS & INPUTS) */\r\n\r\n/* Modern Input Fields */\r\ninput[type=\"text\"], \r\ninput[type=\"password\"], \r\nselect, \r\ntextarea {\r\n border: 1px solid #cbd5e1 !important; /* Slate 300 */\r\n border-radius: var(--radius-md) !important;\r\n padding: 10px 14px !important;\r\n font-size: 0.95rem !important;\r\n background-color: #fff !important;\r\n transition: all 0.2s var(--ease-out);\r\n box-shadow: var(--shadow-sm);\r\n}\r\n\r\ninput:focus, select:focus, textarea:focus {\r\n border-color: var(--primary) !important;\r\n box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.2) !important; /* Ring effect */\r\n outline: none;\r\n}\r\n\r\n/* Buttons - \"Pill\" shape or Soft Rounded */\r\n.button, .butAction {\r\n background: var(--primary) !important;\r\n background-image: none !important;\r\n color: white !important;\r\n border: none !important;\r\n border-radius: var(--radius-md) !important;\r\n padding: 10px 24px !important;\r\n font-weight: 600 !important;\r\n box-shadow: 0 4px 6px -1px rgba(99, 102, 241, 0.4) !important; /* Colored shadow */\r\n transition: transform 0.2s var(--ease-out), box-shadow 0.2s var(--ease-out) !important;\r\n text-transform: none !important; /* Hapus uppercase kaku jika ada */\r\n}\r\n\r\n.button:hover, .butAction:hover {\r\n background: var(--primary-hover) !important;\r\n transform: translateY(-2px); /* Subtle lift */\r\n box-shadow: 0 10px 15px -3px rgba(99, 102, 241, 0.5) !important;\r\n}\r\n\r\n/* Secondary Buttons (Cancel/Back) */\r\n.buttonRefused, .butActionRefused {\r\n background: white !important;\r\n color: var(--text-muted) !important;\r\n border: 1px solid #cbd5e1 !important;\r\n box-shadow: var(--shadow-sm) !important;\r\n}\r\n\r\n/* 6. TOP NAVIGATION (Header) */\r\ndiv.login_block {\r\n background: var(--primary) !important; /* Opsional: Warna solid header */\r\n}\r\n\r\n/* Top Menu items */\r\n.tmenu, .tmenudisabled {\r\n font-family: var(--font-stack) !important;\r\n font-weight: 500 !important;\r\n}\r\n\r\n/* 7. UTILITY & CLEANUP */\r\n/* Hapus border tajam pada gambar profil */\r\n.photoref img, .photo img {\r\n border-radius: 50% !important;\r\n border: 2px solid white !important;\r\n box-shadow: var(--shadow-md);\r\n}\r\n\r\n/* Status Badges (Draft, Validated, etc) */\r\n.badge {\r\n border-radius: 30px !important;\r\n padding: 4px 12px !important;\r\n font-weight: 600 !important;\r\n font-size: 0.75rem !important;\r\n letter-spacing: 0.02em;\r\n}\r\n\r\n/* Scrollbar Modern */\r\n::-webkit-scrollbar {\r\n width: 8px;\r\n height: 8px;\r\n}\r\n::-webkit-scrollbar-track {\r\n background: transparent;\r\n}\r\n::-webkit-scrollbar-thumb {\r\n background: #cbd5e1;\r\n border-radius: 4px;\r\n}\r\n::-webkit-scrollbar-thumb:hover {\r\n background: #94a3b8;\r\n}', 'chaine', 0, '', 1)
