2026-02-05 06:34:04 DEBUG   ::1                8940         sql=INSERT INTO llx_const(name, value, type, visible, note, entity) VALUES ('MAIN_IHM_CUSTOM_CSS', '/* =========================================\r\n DOLIBARR MODERN PRO THEME v2.0\r\n Style: Clean, High Contrast, Animated\r\n ========================================= */\r\n\r\n:root {\r\n /* Palette Warna Utama - Lebih Strong & Kontras */\r\n --primary-color: #4338ca; /* Indigo 700 - Lebih gelap/strong */\r\n --primary-light: #6366f1; /* Indigo 500 */\r\n --primary-hover: #3730a3; /* Indigo 800 */\r\n --accent-color: #0ea5e9; /* Sky Blue untuk aksen */\r\n \r\n /* Backgrounds */\r\n --bg-body: #f3f5f8; /* Abu-abu kebiruan sangat muda */\r\n --bg-surface: #ffffff;\r\n --bg-sidebar: #ffffff;\r\n \r\n /* Typography */\r\n --text-main: #111827; /* Hampir hitam, kontras tinggi */\r\n --text-muted: #6b7280;\r\n --text-light: #9ca3af;\r\n \r\n /* Borders & Radius */\r\n --border-color: #e2e8f0;\r\n --radius-sm: 6px;\r\n --radius-md: 10px; /* Lebih rounded */\r\n --radius-lg: 16px;\r\n \r\n /* Modern Shadows (Lebih Deep) */\r\n --shadow-sm: 0 1px 3px rgba(0,0,0,0.05);\r\n --shadow-card: 0 10px 15px -3px rgba(0, 0, 0, 0.05), 0 4px 6px -2px rgba(0, 0, 0, 0.025);\r\n --shadow-float: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);\r\n \r\n /* Transitions */\r\n --trans-fast: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);\r\n --trans-smooth: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);\r\n}\r\n\r\n/* --- 1. Global & Animasi --- */\r\n\r\n/* Animasi Masuk Halaman */\r\n@keyframes fadeInUp {\r\n from { opacity: 0; transform: translateY(15px); }\r\n to { opacity: 1; transform: translateY(0); }\r\n}\r\n\r\nhtml {\r\n scroll-behavior: smooth;\r\n}\r\n\r\nbody {\r\n font-family: \'Inter\', \'Segoe UI\', Roboto, Helvetica, Arial, sans-serif !important;\r\n background-color: var(--bg-body) !important;\r\n color: var(--text-main);\r\n line-height: 1.6;\r\n -webkit-font-smoothing: antialiased; /* Font lebih tajam */\r\n}\r\n\r\n/* Custom Scrollbar (Webkit) */\r\n::-webkit-scrollbar {\r\n width: 8px;\r\n height: 8px;\r\n}\r\n::-webkit-scrollbar-track {\r\n background: transparent;\r\n}\r\n::-webkit-scrollbar-thumb {\r\n background: #cbd5e1;\r\n border-radius: 10px;\r\n}\r\n::-webkit-scrollbar-thumb:hover {\r\n background: #94a3b8;\r\n}\r\n\r\n/* --- 2. Top Navigation (Menu Atas) --- */\r\ndiv.tmenu, .login_block {\r\n background: rgba(255, 255, 255, 0.95) !important;\r\n backdrop-filter: blur(10px); /* Efek kaca buram modern */\r\n border-bottom: 1px solid var(--border-color);\r\n box-shadow: var(--shadow-sm);\r\n height: 60px; /* Sedikit lebih tinggi */\r\n}\r\n\r\n/* Item Menu Atas */\r\na.tmenuimage {\r\n color: var(--text-muted) !important;\r\n font-weight: 600;\r\n padding: 5px 12px;\r\n transition: var(--trans-fast);\r\n border-radius: var(--radius-sm);\r\n}\r\n\r\na.tmenuimage:hover, a.tmenuimage:focus {\r\n color: var(--primary-color) !important;\r\n background: #eef2ff !important; /* Indigo sangat muda */\r\n transform: translateY(-1px);\r\n}\r\n\r\n/* User Profile di pojok kanan */\r\ndiv.login_block a {\r\n font-weight: 600 !important;\r\n color: var(--primary-color) !important;\r\n}\r\n\r\n/* --- 3. Sidebar (Menu Kiri) --- */\r\ndiv.vmenu {\r\n border-right: 1px solid transparent !important; /* Hilangkan border default */\r\n background: transparent !important;\r\n padding-top: 20px;\r\n}\r\n\r\n/* Judul Kategori Menu */\r\n.vmenu .titre {\r\n color: var(--text-light) !important;\r\n font-size: 0.75rem;\r\n text-transform: uppercase;\r\n letter-spacing: 0.1em;\r\n font-weight: 800;\r\n margin: 20px 0 10px 15px;\r\n border-bottom: none !important;\r\n}\r\n\r\n/* Link Menu Kiri */\r\na.vmenu {\r\n display: block;\r\n border-radius: 0 20px 20px 0; /* Rounded hanya di kanan */\r\n margin: 4px 15px 4px 0; /* Margin kanan agar tidak nempel */\r\n padding: 10px 15px !important;\r\n transition: var(--trans-fast);\r\n color: var(--text-muted) !important;\r\n font-weight: 500;\r\n border-left: 3px solid transparent;\r\n}\r\n\r\n/* Hover Menu Kiri */\r\na.vmenu:hover {\r\n background: #ffffff !important;\r\n color: var(--primary-color) !important;\r\n box-shadow: 5px 5px 15px rgba(0,0,0,0.05);\r\n transform: translateX(5px);\r\n border-left: 3px solid var(--primary-color);\r\n}\r\n\r\n/* Menu Aktif (Jika ada class active) */\r\na.vmenu.active {\r\n background: linear-gradient(90deg, #eef2ff, #ffffff) !important;\r\n color: var(--primary-color) !important;\r\n border-left-color: var(--primary-color);\r\n}\r\n\r\n/* --- 4. Main Content Cards (Kotak Konten) --- */\r\n\r\n/* Wrapper utama konten - Animasi masuk */\r\ndiv.fiche, .tabBar, .box {\r\n border: 1px solid var(--border-color) !important;\r\n border-radius: var(--radius-md) !important;\r\n background-color: var(--bg-surface) !important;\r\n box-shadow: var(--shadow-card) !important;\r\n padding: 24px !important;\r\n margin-bottom: 24px !important;\r\n animation: fadeInUp 0.6s ease-out forwards; /* Jalankan animasi */\r\n}\r\n\r\n/* Judul Halaman Utama */\r\n.titre {\r\n font-family: \'Inter\', sans-serif !important;\r\n font-size: 1.75rem !important; /* Lebih besar */\r\n font-weight: 700 !important;\r\n color: var(--text-main) !important;\r\n letter-spacing: -0.02em;\r\n margin-bottom: 20px;\r\n background: none !important;\r\n padding-left: 0 !important;\r\n}\r\n\r\n/* Dashboard Widgets (.box) */\r\n.box {\r\n margin-bottom: 20px !important;\r\n transition: var(--trans-smooth);\r\n}\r\n.box:hover {\r\n transform: translateY(-5px);\r\n box-shadow: var(--shadow-float) !important;\r\n}\r\n.box_titre {\r\n border-bottom: 1px solid var(--border-color) !important;\r\n font-weight: 700 !important;\r\n color: var(--primary-color) !important;\r\n font-size: 1.1em;\r\n}\r\n\r\n/* --- 5. Tables (Tabel Data Modern) --- */\r\ntable.liste, .div-table-responsive {\r\n border-collapse: separate;\r\n border-spacing: 0;\r\n width: 100%;\r\n}\r\n\r\n/* Header Tabel */\r\ntr.liste_titre, tr.liste_titre_sel {\r\n background: #f8fafc !important;\r\n height: 50px !important;\r\n}\r\n\r\ntr.liste_titre th, tr.liste_titre td {\r\n border-bottom: 1px solid var(--border-color) !important;\r\n color: var(--text-muted) !important;\r\n font-weight: 700 !important;\r\n text-transform: uppercase;\r\n font-size: 0.75rem;\r\n letter-spacing: 0.05em;\r\n padding: 12px 15px !important;\r\n}\r\n\r\n/* Isi Tabel */\r\n.pair, .impair, .oddeven {\r\n background: #fff !important;\r\n transition: background 0.2s;\r\n height: 60px; /* Baris lebih tinggi agar lega */\r\n}\r\n\r\ntd {\r\n border-bottom: 1px solid var(--border-color) !important;\r\n padding: 12px 15px !important;\r\n vertical-align: middle !important;\r\n color: var(--text-main);\r\n font-size: 0.95rem;\r\n}\r\n\r\n/* Hover Row Effect */\r\n.pair:hover, .impair:hover, .oddeven:hover {\r\n background-color: #f1f5f9 !important; /* Slate 100 */\r\n cursor: default;\r\n}\r\n\r\n/* Link di dalam tabel */\r\ntable.liste a {\r\n color: var(--primary-color);\r\n font-weight: 500;\r\n text-decoration: none;\r\n}\r\ntable.liste a:hover {\r\n text-decoration: underline;\r\n color: var(--primary-hover);\r\n}\r\n\r\n/* --- 6. Buttons (Tombol Premium) --- */\r\n.button, .butAction {\r\n background: linear-gradient(135deg, var(--primary-light), var(--primary-color)) !important; /* Gradient halus */\r\n border: none !important;\r\n color: white !important;\r\n padding: 12px 24px !important; /* Padding lebih besar */\r\n border-radius: var(--radius-sm) !important;\r\n font-weight: 600 !important;\r\n box-shadow: 0 4px 6px -1px rgba(79, 70, 229, 0.4);\r\n transition: var(--trans-fast);\r\n text-transform: none !important;\r\n cursor: pointer;\r\n display: inline-block;\r\n line-height: 1.2;\r\n}\r\n\r\n.button:hover, .butAction:hover {\r\n background: linear-gradient(135deg, var(--primary-color), var(--primary-hover)) !important;\r\n box-shadow: 0 10px 15px -3px rgba(79, 70, 229, 0.5);\r\n transform: translateY(-2px) scale(1.02); /* Efek naik dan membesar sedikit */\r\n}\r\n\r\n.button:active, .butAction:active {\r\n transform: translateY(1px) scale(0.98); /* Efek tekan */\r\n}\r\n\r\n/* Tombol Delete/Refuse - Merah */\r\n.buttonRefuse, .butActionRefuse, .buttonDelete, .butActionDelete {\r\n background: linear-gradient(135deg, #ef4444, #dc2626) !important;\r\n box-shadow: 0 4px 6px -1px rgba(239, 68, 68, 0.4);\r\n}\r\n.buttonRefuse:hover, .buttonDelete:hover {\r\n background: linear-gradient(135deg, #dc2626, #b91c1c) !important;\r\n box-shadow: 0 10px 15px -3px rgba(220, 38, 38, 0.5);\r\n}\r\n\r\n/* Tombol Cancel - Abu */\r\n.buttonCancel, .butActionCancel {\r\n background: #f3f4f6 !important;\r\n color: var(--text-main) !important;\r\n border: 1px solid var(--border-color) !important;\r\n box-shadow: none;\r\n}\r\n.buttonCancel:hover {\r\n background: #e5e7eb !important;\r\n color: #000 !important;\r\n}\r\n\r\n/* --- 7. Forms (Input Fields Modern) --- */\r\ninput[type=\"text\"], input[type=\"password\"], input[type=\"email\"], select, textarea {\r\n border: 1px solid var(--border-color) !important;\r\n border-radius: var(--radius-sm) !important;\r\n padding: 12px !important; /* Input lebih tinggi */\r\n background: #f9fafb !important;\r\n box-shadow: inset 0 1px 2px rgba(0,0,0,0.05) !important;\r\n transition: var(--trans-fast);\r\n color: var(--text-main);\r\n font-size: 0.95rem;\r\n}\r\n\r\n/* Input Focus State - Glow Effect */\r\ninput:focus, select:focus, textarea:focus {\r\n border-color: var(--primary-color) !important;\r\n background: #fff !important;\r\n outline: none !important;\r\n box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.2) !important; /* Ring focus glow */\r\n}\r\n\r\n/* Select2 containers (Dropdown modern jika Dolibarr pakai plugin) */\r\n.select2-container .select2-selection--single {\r\n height: 40px !important;\r\n border-color: var(--border-color) !important;\r\n border-radius: var(--radius-sm) !important;\r\n}\r\n\r\n/* --- 8. Tabs (Navigasi Halaman Dalam) --- */\r\n.tabs {\r\n border-bottom: 2px solid var(--border-color) !important;\r\n marg
