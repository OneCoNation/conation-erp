2026-02-05 03:30:36 DEBUG   ::1                8940         sql=INSERT INTO llx_const(name, value, type, visible, note, entity) VALUES ('MAIN_IHM_CUSTOM_CSS', '/* ==========================================================================\r\n THEME: ENTERPRISE GRADE \"FLAWLESS\" ERP\r\n VERSION: 2.0 (Aggressive Modernization)\r\n TARGET: Dolibarr Core Layout\r\n ========================================================================== */\r\n\r\n/* 1. DESIGN TOKENS (Sistem Variabel) */\r\n:root {\r\n /* Brand Colors - Ubah --primary-h/s/l untuk ganti tema warna dengan cepat */\r\n --primary-h: 245; \r\n --primary-s: 80%;\r\n --primary-l: 60%;\r\n \r\n --c-primary: hsl(var(--primary-h), var(--primary-s), var(--primary-l));\r\n --c-primary-dark: hsl(var(--primary-h), var(--primary-s), 45%);\r\n --c-primary-light: hsl(var(--primary-h), var(--primary-s), 95%);\r\n --c-accent: #0ea5e9; /* Sky Blue */\r\n --c-danger: #ef4444;\r\n --c-success: #10b981;\r\n\r\n /* Surfaces */\r\n --bg-body: #f1f5f9; /* Slate 100 */\r\n --bg-card: #ffffff;\r\n --bg-sidebar: #ffffff;\r\n\r\n /* Typography */\r\n --font-main: \'Inter\', \'Plus Jakarta Sans\', system-ui, sans-serif;\r\n\r\n /* Shadows (Elevation System) */\r\n --shadow-subtle: 0 1px 2px 0 rgb(0 0 0 / 0.05);\r\n --shadow-card: 0 4px 6px -1px rgb(0 0 0 / 0.05), 0 2px 4px -2px rgb(0 0 0 / 0.05);\r\n --shadow-float: 0 10px 15px -3px rgb(0 0 0 / 0.08), 0 4px 6px -4px rgb(0 0 0 / 0.08);\r\n --shadow-glow: 0 0 15px rgba(var(--primary-h), 50, 50, 0.3);\r\n\r\n /* Animation */\r\n --trans-spring: cubic-bezier(0.34, 1.56, 0.64, 1); /* Efek membal halus */\r\n --trans-smooth: cubic-bezier(0.4, 0, 0.2, 1);\r\n}\r\n\r\n/* 2. GLOBAL RESET & BASE */\r\nbody {\r\n background-color: var(--bg-body) !important;\r\n font-family: var(--font-main) !important;\r\n color: #334155 !important;\r\n -webkit-font-smoothing: antialiased;\r\n font-size: 14px !important;\r\n}\r\n\r\n/* Memperbaiki Scrollbar agar elegan */\r\n::-webkit-scrollbar {\r\n width: 8px;\r\n height: 8px;\r\n}\r\n::-webkit-scrollbar-track {\r\n background: transparent;\r\n}\r\n::-webkit-scrollbar-thumb {\r\n background: #cbd5e1;\r\n border-radius: 10px;\r\n border: 2px solid var(--bg-body);\r\n}\r\n\r\n/* 3. TRANSFORMATION: SIDEBAR & MENU (Glassy & Clean) */\r\n/* Reset container sidebar */\r\ndiv.side-nav, div.vmenu, .blockvmenu {\r\n border: none !important;\r\n background: transparent !important;\r\n box-shadow: none !important;\r\n}\r\n\r\n/* Judul Menu */\r\n.menu_titre {\r\n font-size: 0.7rem !important;\r\n text-transform: uppercase;\r\n letter-spacing: 0.1em;\r\n color: #94a3b8 !important; /* Slate 400 */\r\n padding: 20px 15px 10px 15px !important;\r\n background: transparent !important;\r\n border-bottom: none !important;\r\n font-weight: 700 !important;\r\n}\r\n\r\n/* Item Menu */\r\na.vmenu {\r\n display: flex !important;\r\n align-items: center;\r\n padding: 12px 16px !important;\r\n margin: 4px 8px !important;\r\n border-radius: 12px !important;\r\n color: #475569 !important;\r\n font-weight: 500 !important;\r\n transition: all 0.3s var(--trans-spring) !important;\r\n border: 1px solid transparent;\r\n}\r\n\r\n/* Ikon Menu - Mengubah warna icon FontAwesome atau IMG */\r\na.vmenu .fa, a.vmenu .fas, a.vmenu .far, a.vmenu img {\r\n color: #64748b !important;\r\n margin-right: 12px !important;\r\n font-size: 1.1em !important;\r\n transition: all 0.3s ease;\r\n filter: grayscale(100%);\r\n opacity: 0.7;\r\n}\r\n\r\n/* Hover State Menu */\r\na.vmenu:hover, a.vmenu:focus {\r\n background: white !important;\r\n color: var(--c-primary) !important;\r\n box-shadow: var(--shadow-card);\r\n transform: translateX(5px); /* Lift effect ke samping */\r\n}\r\n\r\n/* Active State / Hover Icon Color */\r\na.vmenu:hover .fa, a.vmenu:hover .fas, a.vmenu:hover img {\r\n color: var(--c-primary) !important;\r\n filter: grayscale(0%);\r\n opacity: 1;\r\n transform: scale(1.1);\r\n}\r\n\r\n/* 4. TRANSFORMATION: CONTENT CARDS (Paper Concept) */\r\n/* Mengubah container utama menjadi kertas putih melayang */\r\ndiv.fiche > table, \r\ndiv.tabBar,\r\n.div-table-responsive {\r\n background: var(--bg-card) !important;\r\n border-radius: 20px !important;\r\n border: 1px solid #e2e8f0 !important; /* Slate 200 thin border */\r\n box-shadow: var(--shadow-card) !important;\r\n margin-bottom: 30px !important;\r\n padding: 25px !important;\r\n overflow: hidden; /* Penting untuk border-radius */\r\n}\r\n\r\n/* Judul Halaman */\r\n.titre {\r\n font-size: 1.5rem !important;\r\n font-weight: 700 !important;\r\n color: #1e293b !important;\r\n text-shadow: none !important;\r\n margin-bottom: 20px !important;\r\n display: inline-block;\r\n position: relative;\r\n}\r\n\r\n/* Garis hiasan di bawah judul */\r\n.titre::after {\r\n content: \'\';\r\n display: block;\r\n width: 40px;\r\n height: 4px;\r\n background: var(--c-primary);\r\n border-radius: 2px;\r\n margin-top: 8px;\r\n}\r\n\r\n/* 5. TRANSFORMATION: TABLES (The Odoo List View) */\r\n/* Teknik ini memisahkan baris tabel agar terlihat floating */\r\n.liste {\r\n width: 100% !important;\r\n border-collapse: separate !important; /* KUNCI UTAMA */\r\n border-spacing: 0 8px !important; /* Memberikan jarak vertikal antar baris */\r\n background: transparent !important;\r\n border: none !important;\r\n}\r\n\r\n/* Header Tabel */\r\n.liste_titre {\r\n background: transparent !important;\r\n color: #64748b !important;\r\n font-size: 0.75rem !important;\r\n font-weight: 700 !important;\r\n text-transform: uppercase;\r\n padding: 10px 15px !important;\r\n border: none !important;\r\n letter-spacing: 0.05em;\r\n}\r\n\r\n/* Baris Data (Row) */\r\n.tagtr, .pair, .impair {\r\n background: #ffffff !important;\r\n box-shadow: var(--shadow-subtle);\r\n transition: transform 0.2s var(--trans-smooth), box-shadow 0.2s var(--trans-smooth) !important;\r\n}\r\n\r\n/* Sel Data (Cells) */\r\n.tagtr td, .pair td, .impair td {\r\n border: none !important;\r\n border-top: 1px solid #f1f5f9 !important;\r\n border-bottom: 1px solid #f1f5f9 !important;\r\n padding: 16px 20px !important; /* Padding lega */\r\n vertical-align: middle !important;\r\n}\r\n\r\n/* Rounded Corners untuk Row (Sisi kiri dan kanan) */\r\n.tagtr td:first-child, .pair td:first-child, .impair td:first-child {\r\n border-top-left-radius: 12px;\r\n border-bottom-left-radius: 12px;\r\n border-left: 1px solid #f1f5f9 !important;\r\n}\r\n\r\n.tagtr td:last-child, .pair td:last-child, .impair td:last-child {\r\n border-top-right-radius: 12px;\r\n border-bottom-right-radius: 12px;\r\n border-right: 1px solid #f1f5f9 !important;\r\n}\r\n\r\n/* Hover Effect pada Row - Lift & Glow */\r\n.tagtr:hover, .pair:hover, .impair:hover {\r\n transform: translateY(-3px) scale(1.005);\r\n background: #ffffff !important;\r\n box-shadow: var(--shadow-float) !important;\r\n z-index: 10;\r\n position: relative;\r\n cursor: pointer;\r\n}\r\n\r\n/* Link di dalam tabel */\r\n.liste a {\r\n text-decoration: none !important;\r\n color: #334155;\r\n font-weight: 500;\r\n}\r\n.liste a:hover {\r\n color: var(--c-primary);\r\n}\r\n\r\n/* 6. TRANSFORMATION: BUTTONS (Consistent & Vibrant) */\r\n/* Menarget SEMUA jenis tombol Dolibarr yang kacau */\r\n.button, \r\n.butAction, \r\n.butActionDelete, \r\ninput[type=\"submit\"], \r\ninput[type=\"button\"], \r\nbutton {\r\n background-color: var(--c-primary) !important;\r\n background-image: linear-gradient(135deg, var(--c-primary) 0%, var(--c-primary-dark) 100%) !important;\r\n color: white !important;\r\n border: none !important;\r\n border-radius: 10px !important; /* Sedikit kotak tapi soft */\r\n padding: 10px 24px !important;\r\n font-size: 0.9rem !important;\r\n font-weight: 600 !important;\r\n letter-spacing: 0.3px;\r\n box-shadow: 0 4px 6px rgba(var(--primary-h), var(--primary-s), 50%, 0.25) !important;\r\n transition: all 0.3s var(--trans-spring) !important;\r\n cursor: pointer;\r\n text-decoration: none !important;\r\n display: inline-flex;\r\n align-items: center;\r\n justify-content: center;\r\n min-height: 40px;\r\n}\r\n\r\n/* Button Hover State */\r\n.button:hover, .butAction:hover, input[type=\"submit\"]:hover {\r\n transform: translateY(-2px);\r\n box-shadow: 0 8px 15px rgba(var(--primary-h), var(--primary-s), 50%, 0.4) !important;\r\n filter: brightness(110%);\r\n}\r\n\r\n/* Button Active/Click State */\r\n.button:active, .butAction:active {\r\n transform: translateY(1px);\r\n box-shadow: none !important;\r\n}\r\n\r\n/* Secondary / Cancel Buttons */\r\n.buttonRefused, .butActionRefused {\r\n background: white !important;\r\n background-image: none !important;\r\n color: #64748b !important;\r\n border: 1px solid #cbd5e1 !important;\r\n box-shadow: var(--shadow-subtle) !important;\r\n}\r\n.buttonRefused:hover {\r\n background: #f8fafc !important;\r\n color: #ef4444 !important; /* Merah saat hover cancel */\r\n border-color: #ef4444 !important;\r\n}\r\n\r\n/* 7. FORMS & INPUTS (Modern Fields) */\r\ninput[type=\"text\"], \r\ninput[type=\"password\"], \r\ninput[type=\"date\"], \r\nselect, \r\ntextarea {\r\n background-color: #f8fafc !important;\r\n border: 1px solid #cbd5e1 !important;\r\n border-radius: 10px !important;\r\n padding: 12px 16px !important;\r\n font-size: 0.95rem !important;\r\n color: #1e293b;\r\n transition: all 0.2s ease-in-out;\r\n width: auto;\r\n max-width: 100%;\r\n}\r\n\r\n/* Focus State - Glowing Ring */\r\ninput:focus, select:focus, textarea:focus {\r\n background-color: #ffffff !important;\r\n border-color: var(--c-primary) !important;\r\n outline: none !important;\r\n box-shadow: 0 0 0 4px var(--c-primary-light) !important;\r\n}\r\n\r\n/* Select2 fixes (Jika Dolibarr Anda menggunakannya) */\r\n.select2-container--default .select2-selection--single {\r\n border-radius: 10px !important;\r\n border: 1px solid #cbd5e1 !important;\r\n height: 42px !important;\r\n padding-top: 6px;\r\n}\r\n\r\n/* 8. TOP HEADER MENU (Glass Effect) */\r\ndiv.login_block {\r\n background: rgba(255, 255, 255, 0.9) !important;\r\n backdrop-filter: blur(10px);\r\n border-bottom: 1px solid white;\r\n box-shadow: 
