2026-02-05 04:13:17 DEBUG   ::1                8940         sql=INSERT INTO llx_const(name, value, type, visible, note, entity) VALUES ('MAIN_IHM_CUSTOM_CSS', '/* ==========================================================================\r\n THEME: MODERN ENTERPRISE FASCINATION (ODOO/FIORI HYBRID)\r\n AUTHOR: GEMINI SR. FRONTEND ENG\r\n VERSION: 2.5 (High-Fidelity Polish)\r\n ========================================================================== */\r\n\r\n/* --- 1. CORE VARIABLES & TYPOGRAPHY --- */\r\n@import url(\'https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap\');\r\n\r\n:root {\r\n --font-main: \'Plus Jakarta Sans\', sans-serif;\r\n --primary: #3b82f6; /* Modern Blue */\r\n --primary-hover: #2563eb;\r\n --bg-app: #f1f5f9; /* Slate 100 - Soft Background */\r\n --bg-surface: #ffffff;\r\n --text-main: #1e293b; /* Slate 800 */\r\n --text-secondary: #64748b; /* Slate 500 */\r\n --border-subtle: #e2e8f0;\r\n --radius-lg: 16px;\r\n --radius-md: 12px;\r\n --radius-sm: 8px;\r\n \r\n /* Layered Shadows (Elevation) */\r\n --shadow-sm: 0 1px 2px 0 rgb(0 0 0 / 0.05);\r\n --shadow-md: 0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1);\r\n --shadow-lg: 0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1);\r\n --shadow-float: 0 20px 25px -5px rgb(0 0 0 / 0.1), 0 8px 10px -6px rgb(0 0 0 / 0.1);\r\n\r\n /* Animation Physics */\r\n --ease-elastic: cubic-bezier(0.34, 1.56, 0.64, 1);\r\n --ease-smooth: cubic-bezier(0.4, 0, 0.2, 1);\r\n}\r\n\r\n/* Global Reset & Base */\r\nbody, html, .vmenulist, .corporate-container, table, input, select, textarea {\r\n font-family: var(--font-main) !important;\r\n color: var(--text-main);\r\n -webkit-font-smoothing: antialiased;\r\n}\r\n\r\nbody {\r\n background-color: var(--bg-app) !important;\r\n line-height: 1.6;\r\n}\r\n\r\n/* Smooth Scrollbar */\r\n::-webkit-scrollbar { width: 8px; height: 8px; }\r\n::-webkit-scrollbar-track { background: transparent; }\r\n::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 10px; }\r\n::-webkit-scrollbar-thumb:hover { background: #94a3b8; }\r\n\r\n/* --- 2. LAYOUT & CONTAINER --- */\r\n\r\n/* Main Containers styling to float like cards */\r\ndiv.fiche, .fichecenter, .tabBar {\r\n background: var(--bg-surface) !important;\r\n border: none !important;\r\n border-radius: var(--radius-lg) !important;\r\n box-shadow: var(--shadow-md) !important;\r\n margin-bottom: 25px !important;\r\n padding: 25px !important;\r\n transition: transform 0.3s var(--ease-smooth), box-shadow 0.3s var(--ease-smooth);\r\n}\r\n\r\n/* Hover effect on main cards for subtle interactivity */\r\ndiv.fiche:hover, .fichecenter:hover {\r\n /* transform: translateY(-2px); Disable if distracting */\r\n box-shadow: var(--shadow-lg) !important;\r\n}\r\n\r\n/* Header/Title Modernization */\r\nh1, h2, .titre {\r\n font-weight: 700 !important;\r\n letter-spacing: -0.025em !important;\r\n color: #0f172a !important; /* Darker Slate */\r\n margin-bottom: 20px !important;\r\n text-shadow: none !important;\r\n}\r\n\r\n/* --- 3. TOP NAVIGATION (FLAWLESS HEADER) --- */\r\n\r\ndiv#id-top {\r\n background: var(--bg-surface) !important;\r\n box-shadow: var(--shadow-sm) !important;\r\n border-bottom: 1px solid var(--border-subtle) !important;\r\n height: 70px !important; /* Taller header */\r\n display: flex;\r\n align-items: center;\r\n}\r\n\r\n/* Menu Items Spacing & Styling */\r\ndiv.tmenudiv {\r\n display: flex;\r\n gap: 8px; /* Spacing antar menu */\r\n align-items: center;\r\n height: 100%;\r\n}\r\n\r\na.tmenu, a.tmenusel {\r\n background: transparent !important;\r\n border-radius: var(--radius-md) !important;\r\n padding: 10px 16px !important;\r\n margin: 0 4px !important;\r\n font-weight: 600 !important;\r\n color: var(--text-secondary) !important;\r\n transition: all 0.2s var(--ease-smooth) !important;\r\n text-transform: none !important; /* No UPPERCASE */\r\n white-space: nowrap;\r\n}\r\n\r\n/* Active State Top Menu */\r\na.tmenusel, a.tmenu:hover {\r\n background-color: #eff6ff !important; /* Blue 50 */\r\n color: var(--primary) !important;\r\n transform: translateY(-1px);\r\n}\r\n\r\n/* --- 4. SIDEBAR NAVIGATION --- */\r\n\r\ndiv.vmenu {\r\n border: none !important;\r\n background: transparent !important;\r\n margin-top: 20px !important;\r\n}\r\n\r\n.vmenu .titre {\r\n color: var(--text-secondary) !important;\r\n font-size: 0.75rem !important;\r\n text-transform: uppercase !important;\r\n letter-spacing: 0.1em !important;\r\n padding-left: 15px !important;\r\n margin-bottom: 10px !important;\r\n}\r\n\r\n/* Menu items */\r\n.vmenu .menu_contenu {\r\n background: transparent !important;\r\n padding: 0 !important;\r\n}\r\n\r\na.vmenu {\r\n display: block;\r\n padding: 12px 18px !important;\r\n margin-bottom: 4px !important;\r\n border-radius: 0 25px 25px 0 !important; /* Modern rounded right side */\r\n color: var(--text-main) !important;\r\n font-weight: 500 !important;\r\n transition: all 0.3s var(--ease-elastic) !important;\r\n text-decoration: none !important;\r\n}\r\n\r\n/* Sidebar Hover & Active */\r\na.vmenu:hover, a.vmenusel {\r\n background: white !important;\r\n color: var(--primary) !important;\r\n box-shadow: 4px 0 12px rgba(0,0,0,0.05) !important;\r\n padding-left: 24px !important; /* Slide effect */\r\n}\r\n\r\n/* --- 5. MODERN TABLE UI (ODOO LIST VIEW STYLE) --- */\r\n\r\ntable.liste, .div-table-responsive {\r\n border-collapse: separate !important;\r\n border-spacing: 0 !important;\r\n width: 100% !important;\r\n background: transparent !important;\r\n border: none !important;\r\n}\r\n\r\n/* Table Header */\r\ntable.liste tr.liste_titre, .tagtable .liste_titre {\r\n background: transparent !important;\r\n border-bottom: 2px solid var(--border-subtle) !important;\r\n}\r\n\r\ntable.liste th, table.liste tr.liste_titre td {\r\n font-size: 0.85rem !important;\r\n text-transform: uppercase;\r\n letter-spacing: 0.05em;\r\n color: var(--text-secondary) !important;\r\n font-weight: 700 !important;\r\n padding: 16px !important;\r\n border: none !important;\r\n border-bottom: 1px solid var(--border-subtle) !important;\r\n}\r\n\r\n/* Table Body Rows */\r\ntable.liste tr {\r\n background: var(--bg-surface) !important;\r\n transition: transform 0.2s var(--ease-smooth), background-color 0.2s;\r\n}\r\n\r\n/* Zebra striping removal & border refinement */\r\ntable.liste tr.pair, table.liste tr.impair {\r\n background: var(--bg-surface) !important;\r\n}\r\n\r\ntable.liste td {\r\n padding: 16px !important; /* More breathing room */\r\n border: none !important;\r\n border-bottom: 1px solid #f1f5f9 !important; /* Very subtle separator */\r\n color: var(--text-main);\r\n vertical-align: middle !important;\r\n}\r\n\r\n/* Row Hover Effect - The \"Soft Lift\" */\r\ntable.liste tr:not(.liste_titre):hover {\r\n background-color: #f8fafc !important; /* Slate 50 */\r\n transform: scale(1.005); /* Micro-interaction scale */\r\n box-shadow: var(--shadow-sm);\r\n z-index: 10;\r\n position: relative;\r\n border-radius: var(--radius-sm);\r\n}\r\n\r\n/* Fix rounded corners for table rows */\r\ntable.liste tr:not(.liste_titre) td:first-child {\r\n border-top-left-radius: var(--radius-sm);\r\n border-bottom-left-radius: var(--radius-sm);\r\n}\r\ntable.liste tr:not(.liste_titre) td:last-child {\r\n border-top-right-radius: var(--radius-sm);\r\n border-bottom-right-radius: var(--radius-sm);\r\n}\r\n\r\n/* --- 6. BUTTONS & ACTIONS (CONSISTENT & FLAWLESS) --- */\r\n\r\n.button, .butAction, .butActionDelete, button {\r\n background-color: var(--bg-surface) !important;\r\n background-image: none !important;\r\n border: 1px solid var(--border-subtle) !important;\r\n border-radius: var(--radius-md) !important;\r\n padding: 10px 24px !important;\r\n font-weight: 600 !important;\r\n font-size: 0.95rem !important;\r\n color: var(--text-main) !important;\r\n box-shadow: var(--shadow-sm) !important;\r\n transition: all 0.3s var(--ease-elastic) !important;\r\n cursor: pointer;\r\n text-decoration: none !important;\r\n}\r\n\r\n/* Primary Action Buttons */\r\n.butAction {\r\n background-color: var(--primary) !important;\r\n color: white !important;\r\n border: 1px solid var(--primary) !important;\r\n box-shadow: 0 4px 10px rgba(59, 130, 246, 0.3) !important; /* Colored shadow */\r\n}\r\n\r\n/* Delete/Danger Buttons */\r\n.butActionDelete {\r\n background-color: white !important;\r\n color: #ef4444 !important; /* Red 500 */\r\n border-color: #fee2e2 !important;\r\n}\r\n\r\n/* Button Hover Interactions */\r\n.button:hover, .butAction:hover, .butActionDelete:hover, button:hover {\r\n transform: translateY(-2px);\r\n box-shadow: var(--shadow-md) !important;\r\n}\r\n\r\n.butAction:hover {\r\n background-color: var(--primary-hover) !important;\r\n}\r\n\r\n/* --- 7. FORMS & INPUTS --- */\r\n\r\ninput[type=\"text\"], input[type=\"password\"], textarea, select, .flat {\r\n border: 1px solid var(--border-subtle) !important;\r\n border-radius: var(--radius-md) !important;\r\n padding: 12px 16px !important;\r\n background-color: #f8fafc !important; /* Input bg slightly off-white */\r\n transition: all 0.2s var(--ease-smooth) !important;\r\n box-shadow: none !important;\r\n width: auto;\r\n font-size: 0.95rem !important;\r\n}\r\n\r\n/* Input Focus State - The \"Glow\" */\r\ninput:focus, select:focus, textarea:focus {\r\n background-color: #fff !important;\r\n border-color: var(--primary) !important;\r\n outline: none !important;\r\n box-shadow: 0 0 0 4px rgba(59, 130, 246, 0.1) !important; /* Soft focus ring */\r\n}\r\n\r\n/* Select2 Container Overrides (if used by Dolibarr modules) */\r\n.select2-container .select2-selection--single {\r\n height: 45px !important;\r\n border-radius: var(--radius-md) !important;\r\n border: 1px solid var(--border-subtle) !important;\r\n padding-top: 8px;\r\n}\r\n\r\n/* --- 8. DASHBOARD WIDGETS --- */\r\n.box {\r\n border: none !important;\r\n box-shadow: none !important;\r\n border-bottom: 1px solid var(--border-subtle);\r\n