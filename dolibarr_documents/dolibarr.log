2026-02-05 03:09:08 DEBUG   ::1                8940         sql=INSERT INTO llx_const(name, value, type, visible, note, entity) VALUES ('MAIN_IHM_CUSTOM_CSS', ';\r\n	line-height: var(--heightrow);\r\n	font-family: ;\r\n	background-color: var(--colorbackbody);\r\n	color: var(--text-main);\r\n	-webkit-font-smoothing: antialiased;\r\n letter-spacing: -0.01em;\r\n}\r\n\r\n/* 1. LAYERED DEPTH & CARDS */\r\ndiv.tabBar {\r\n	background: var(--colorbacktabcard1) !important;\r\n	border: 1px solid var(--border-light) !important;\r\n	border-radius: !important;\r\n	box-shadow: !important;\r\n	padding: 32px !important;\r\n	margin-bottom: 30px !important;\r\n}\r\n\r\n/* 2. MODERN NAVIGATION (Top Menu) */\r\n#id-top {\r\n background: var(--colorbackhmenu1) !important;\r\n backdrop-filter: blur(10px);\r\n border-bottom: 1px solid rgba(255,255,255,0.1) !important;\r\n box-shadow: ;\r\n}\r\n\r\n.tmenudiv {\r\n transition: var(--transition-standard);\r\n}\r\n\r\nli.tmenu:hover, li.tmenusel {\r\n background: rgba(255,255,255,0.1) !important;\r\n border-radius: 8px;\r\n}\r\n\r\n/* 3. MODERN SIDEBAR (Odoo Style) */\r\n.side-nav {\r\n background: #ffffff !important;\r\n border-: 1px solid var(--border-light) !important;\r\n box-shadow: 10px 0 30px rgba(0,0,0,0.02) !important;\r\n}\r\n\r\n.blockvmenupair, .blockvmenuimpair {\r\n background: transparent !important;\r\n border: none !important;\r\n}\r\n\r\na.vmenu, a.vsmenu {\r\n padding: 10px 15px !important;\r\n margin: 2px 10px !important;\r\n border-radius: 8px !important;\r\n transition: var(--transition-standard) !important;\r\n font-weight: 500 !important;\r\n color: var(--text-muted) !important;\r\n}\r\n\r\na.vmenu:hover, a.vsmenu:hover {\r\n background: #f1f5f9 !important;\r\n color: var(--primary-vibrant) !important;\r\n transform: translateX(4px);\r\n}\r\n\r\n/* 4. MODERN TABLES (List View) */\r\ntable.liste {\r\n border-collapse: separate !important;\r\n border-spacing: 0 !important;\r\n border: 1px solid var(--border-light) !important;\r\n border-radius: !important;\r\n overflow: hidden;\r\n box-shadow: ;\r\n background: #ffffff;\r\n}\r\n\r\ntable.liste tr.liste_titre {\r\n background: #f8fafc !important;\r\n text-transform: uppercase;\r\n font-size: 0.75rem;\r\n letter-spacing: 0.05em;\r\n color: var(--text-muted);\r\n border-bottom: 2px solid var(--border-light) !important;\r\n}\r\n\r\ntable.liste td {\r\n padding: 14px 12px !important;\r\n border-bottom: 1px solid var(--border-light) !important;\r\n border-right: none !important;\r\n transition: var(--transition-standard);\r\n}\r\n\r\ntable.liste tr:hover td {\r\n background-color: #f1f5f9 !important;\r\n}\r\n\r\n/* 5. FORM INPUTS & BUTTONS */\r\ninput, select, textarea {\r\n border-radius: !important;\r\n border: 1px solid var(--border-light) !important;\r\n padding: 10px 14px !important;\r\n transition: var(--transition-standard) !important;\r\n box-shadow: inset 0 1px 2px rgba(0,0,0,0.02);\r\n}\r\n\r\ninput:focus, select:focus, textarea:focus {\r\n border-color: var(--primary-vibrant) !important;\r\n box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.1) !important;\r\n outline: none;\r\n}\r\n\r\n#mainbody input.button, #mainbody a.button {\r\n background: var(--primary-vibrant) !important;\r\n border-radius: !important;\r\n font-weight: 600 !important;\r\n padding: 10px 24px !important;\r\n text-transform: none !important;\r\n box-shadow: 0 4px 6px -1px rgba(79, 70, 229, 0.2) !important;\r\n transition: var(--transition-standard) !important;\r\n}\r\n\r\n#mainbody input.button:hover, #mainbody a.button:hover {\r\n transform: translateY(-2px);\r\n box-shadow: 0 10px 15px -3px rgba(79, 70, 229, 0.3) !important;\r\n}\r\n\r\n/* 6. TABS NAVIGATION */\r\na.tab {\r\n padding: 12px 20px !important;\r\n margin-right: 4px !important;\r\n border-radius: 10px 10px 0 0 !important;\r\n font-weight: 600 !important;\r\n transition: var(--transition-standard);\r\n}\r\n\r\na.tabactive, a.tab#active {\r\n background: var(--colorbacktabcard1) !important;\r\n border-top: 3px solid var(--primary-vibrant) !important;\r\n color: var(--primary-vibrant) !important;\r\n}\r\n\r\n/* 7. BADGES & STATUS */\r\n.badge {\r\n border-radius: 9999px !important;\r\n padding: 4px 12px !important;\r\n font-weight: 700 !important;\r\n text-transform: uppercase;\r\n font-size: 0.65rem !important;\r\n}\r\n\r\n/* 8. FICHE OBJECT TITLE */\r\n.titre {\r\n font-size: 1.5rem !important;\r\n font-weight: 800 !important;\r\n color: var(--text-main);\r\n letter-spacing: -0.025em;\r\n margin-bottom: 20px;\r\n}\r\n\r\n/* 9. SEARCH PANEL */\r\ndiv.divsearchfield {\r\n background: #ffffff;\r\n border-radius: 12px;\r\n padding: 15px !important;\r\n margin-bottom: 20px;\r\n border: 1px solid var(--border-light);\r\n}\r\n\r\n/* 10. SCROLLBARS */\r\n::-webkit-scrollbar {\r\n width: 8px;\r\n height: 8px;\r\n}\r\n::-webkit-scrollbar-track {\r\n background: #f1f5f9;\r\n}\r\n::-webkit-scrollbar-thumb {\r\n background: #cbd5e1;\r\n border-radius: 10px;\r\n}\r\n::-webkit-scrollbar-thumb:hover {\r\n background: #94a3b8;\r\n}\r\n\r\n/* FIXING ORIGINAL DOLIBARR OVERRIDES */\r\n.noborder, .bordernooddeven {\r\n border: none !important;\r\n}\r\n\r\n#id-right {\r\n padding-top: 25px !important;\r\n padding-left: 30px !important;\r\n padding-right: 30px !important;\r\n}\r\n\r\n/* Preserve PHP Logic for dynamically generated icons/modules */\r\n\r\n\r\n\r\n/* End of Custom Modern CSS */', 'chaine', 0, '', 1)
