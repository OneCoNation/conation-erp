2026-02-05 06:18:18 DEBUG   ::1                8940         sql=INSERT INTO llx_const(name, value, type, visible, note, entity) VALUES ('MAIN_IHM_CUSTOM_CSS', '/* --- MODERN DOLIBARR UI THEME --- */\r\n\r\n:root {\r\n --primary-color: #4F46E5; /* Indigo Modern */\r\n --primary-hover: #4338ca;\r\n --bg-body: #f3f4f6;\r\n --bg-surface: #ffffff;\r\n --text-main: #1f2937;\r\n --text-muted: #6b7280;\r\n --border-color: #e5e7eb;\r\n --radius: 8px;\r\n --shadow-sm: 0 1px 2px 0 rgba(0, 0, 0, 0.05);\r\n --shadow-md: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);\r\n}\r\n\r\n/* 1. Global Typography & Background */\r\nbody, button, input, select, textarea {\r\n font-family: \'Segoe UI\', Inter, Roboto, Helvetica, Arial, sans-serif !important;\r\n color: var(--text-main);\r\n}\r\n\r\nbody {\r\n background-color: var(--bg-body) !important;\r\n}\r\n\r\n/* 2. Top Navigation Bar (Menu Atas) */\r\ndiv.tmenu, .login_block {\r\n background: #ffffff !important; /* Ubah jadi putih bersih */\r\n background-image: none !important;\r\n border-bottom: 1px solid var(--border-color);\r\n box-shadow: var(--shadow-sm);\r\n}\r\n\r\ndiv.tmenudiv {\r\n background: transparent !important;\r\n background-image: none !important;\r\n}\r\n\r\na.tmenuimage {\r\n color: var(--text-muted) !important;\r\n font-weight: 500;\r\n}\r\n\r\na.tmenuimage:hover {\r\n color: var(--primary-color) !important;\r\n background: rgba(79, 70, 229, 0.05) !important;\r\n border-radius: var(--radius);\r\n}\r\n\r\n/* 3. Left Sidebar (Menu Kiri) */\r\ndiv.vmenu {\r\n border-right: none !important;\r\n background: transparent !important;\r\n}\r\n\r\n.vmenu .titre {\r\n color: var(--text-muted) !important;\r\n font-size: 0.85rem;\r\n text-transform: uppercase;\r\n letter-spacing: 0.05em;\r\n font-weight: 700;\r\n margin-top: 15px;\r\n}\r\n\r\na.vmenu {\r\n border-radius: var(--radius);\r\n margin: 2px 5px;\r\n padding: 8px 10px !important;\r\n transition: all 0.2s ease;\r\n}\r\n\r\na.vmenu:hover, a.vmenu.vmenu:focus {\r\n background-color: #ffffff !important;\r\n color: var(--primary-color) !important;\r\n box-shadow: var(--shadow-sm);\r\n transform: translateX(3px);\r\n}\r\n\r\n/* 4. Cards & Content Containers (Kotak Konten) */\r\ndiv.fiche, .tabBar {\r\n border: none !important;\r\n border-radius: var(--radius) !important;\r\n background-color: var(--bg-surface) !important;\r\n box-shadow: var(--shadow-md) !important;\r\n padding: 20px !important;\r\n margin-bottom: 20px !important;\r\n}\r\n\r\n/* Judul Halaman */\r\n.titre {\r\n text-decoration: none !important;\r\n font-size: 1.5rem !important;\r\n font-weight: 600 !important;\r\n color: #111827 !important;\r\n padding-bottom: 15px;\r\n}\r\n\r\n/* 5. Tables (Tabel Data) */\r\ntable.liste, .div-table-responsive {\r\n border-collapse: separate;\r\n border-spacing: 0;\r\n width: 100%;\r\n}\r\n\r\ntr.liste_titre, tr.liste_titre_sel, .tagtr.liste_titre {\r\n background: #f9fafb !important;\r\n background-image: none !important;\r\n height: 45px !important;\r\n}\r\n\r\ntr.liste_titre th, tr.liste_titre td {\r\n border-bottom: 2px solid var(--border-color) !important;\r\n color: var(--text-muted) !important;\r\n font-weight: 600 !important;\r\n text-transform: uppercase;\r\n font-size: 0.75rem;\r\n}\r\n\r\n/* Baris Tabel */\r\n.pair, .impair, .oddeven {\r\n background: #fff !important;\r\n transition: background 0.15s;\r\n height: 50px; /* Lebih tinggi supaya lega */\r\n}\r\n\r\n.pair:hover, .impair:hover, .oddeven:hover {\r\n background-color: #f3f4f6 !important;\r\n}\r\n\r\ntd {\r\n border-bottom: 1px solid var(--border-color) !important;\r\n padding: 10px 12px !important;\r\n vertical-align: middle !important;\r\n}\r\n\r\n/* 6. Buttons (Tombol) */\r\n.button, .butAction {\r\n background: var(--primary-color) !important;\r\n background-image: none !important;\r\n border: none !important;\r\n color: white !important;\r\n padding: 10px 20px !important;\r\n border-radius: var(--radius) !important;\r\n font-weight: 500 !important;\r\n box-shadow: var(--shadow-sm);\r\n transition: all 0.2s;\r\n text-transform: none !important;\r\n}\r\n\r\n.button:hover, .butAction:hover {\r\n background: var(--primary-hover) !important;\r\n box-shadow: 0 4px 6px -1px rgba(79, 70, 229, 0.3);\r\n transform: translateY(-1px);\r\n}\r\n\r\n.buttonRefuse, .butActionRefuse {\r\n background: #ef4444 !important; /* Merah modern */\r\n}\r\n\r\n.buttonDelete, .butActionDelete {\r\n background: #ef4444 !important;\r\n}\r\n\r\n/* 7. Forms (Input & Select) */\r\ninput[type=\"text\"], input[type=\"password\"], select, textarea {\r\n border: 1px solid var(--border-color) !important;\r\n border-radius: var(--radius) !important;\r\n padding: 10px !important;\r\n background: #f9fafb !important;\r\n box-shadow: none !important;\r\n transition: border-color 0.2s;\r\n}\r\n\r\ninput:focus, select:focus, textarea:focus {\r\n border-color: var(--primary-color) !important;\r\n background: #fff !important;\r\n outline: none !important;\r\n box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.1) !important;\r\n}\r\n\r\n/* Membersihkan garis-garis lama */\r\n.tabs {\r\n border-bottom: 1px solid var(--border-color) !important;\r\n}\r\n.tab {\r\n background: transparent !important;\r\n border: none !important;\r\n border-bottom: 2px solid transparent !important;\r\n}\r\n.tab.active {\r\n background: transparent !important;\r\n border-bottom: 2px solid var(--primary-color) !important;\r\n color: var(--primary-color) !important;\r\n font-weight: 600;\r\n}', 'chaine', 0, '', 1)
