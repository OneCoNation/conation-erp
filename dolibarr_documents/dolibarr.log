2026-02-05 04:17:18 DEBUG   ::1                8940         sql=INSERT INTO llx_const(name, value, type, visible, note, entity) VALUES ('MAIN_IHM_CUSTOM_CSS', '/* ==========================================================================\r\n THEME: DOLIBARR MODERN FLUX (2025 EDITION)\r\n AUTHOR: GEMINI SR. FRONTEND ENG\r\n CONCEPT: ODOO 17 STRUCTURE + TAILWIND UTILITY + SAP FIORI DEPTH\r\n ========================================================================== */\r\n\r\n/* --- 1. CORE VARIABLES & TYPOGRAPHY --- */\r\n@import url(\'https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap\');\r\n\r\n:root {\r\n /* Palette - Ubah warna ini sesuai branding perusahaan */\r\n --primary: #3b82f6; /* Royal Blue */\r\n --primary-hover: #2563eb;\r\n --primary-soft: rgba(59, 130, 246, 0.1);\r\n \r\n /* Backgrounds */\r\n --bg-app: #f8fafc; /* Slate 50 */\r\n --bg-surface: #ffffff;\r\n \r\n /* Typography */\r\n --font-main: \'Plus Jakarta Sans\', sans-serif;\r\n --text-main: #1e293b; /* Slate 800 */\r\n --text-muted: #64748b; /* Slate 500 */\r\n \r\n /* Borders & Radius */\r\n --border-subtle: #e2e8f0;\r\n --radius-xl: 16px;\r\n --radius-lg: 12px;\r\n --radius-md: 8px;\r\n \r\n /* Shadows (Elevation System) */\r\n --shadow-sm: 0 1px 2px 0 rgb(0 0 0 / 0.05);\r\n --shadow-card: 0 4px 6px -1px rgb(0 0 0 / 0.05), 0 2px 4px -2px rgb(0 0 0 / 0.05);\r\n --shadow-hover: 0 20px 25px -5px rgb(0 0 0 / 0.1), 0 8px 10px -6px rgb(0 0 0 / 0.1);\r\n \r\n /* Animation Physics */\r\n --ease-spring: cubic-bezier(0.4, 0, 0.2, 1);\r\n}\r\n\r\n/* --- 2. GLOBAL RESET --- */\r\nbody, html, .vmenulist, .corporate-container, table, input, select, textarea, button {\r\n font-family: var(--font-main) !important;\r\n color: var(--text-main);\r\n -webkit-font-smoothing: antialiased;\r\n}\r\n\r\nbody {\r\n background-color: var(--bg-app) !important;\r\n font-size: 14px;\r\n line-height: 1.5;\r\n}\r\n\r\n/* Smooth Custom Scrollbar */\r\n::-webkit-scrollbar { width: 8px; height: 8px; }\r\n::-webkit-scrollbar-track { background: transparent; }\r\n::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 10px; }\r\n::-webkit-scrollbar-thumb:hover { background: #94a3b8; }\r\n\r\n/* --- 3. TOP NAVIGATION (SPACIOUS & MODERN) --- */\r\ndiv#id-top {\r\n background: var(--bg-surface) !important;\r\n border-bottom: 1px solid var(--border-subtle) !important;\r\n box-shadow: var(--shadow-sm) !important;\r\n height: 72px !important; /* Tinggi fix untuk vertikal centering */\r\n padding: 0 24px !important;\r\n display: flex;\r\n align-items: center;\r\n}\r\n\r\ndiv.tmenudiv {\r\n display: flex !important;\r\n align-items: center !important;\r\n gap: 24px !important; /* SPACING ANTAR MENU (Permintaan User) */\r\n height: 100% !important;\r\n white-space: nowrap !important;\r\n}\r\n\r\n/* Menu Item Style (Pills) */\r\na.tmenu, a.tmenusel {\r\n background: transparent !important;\r\n border-radius: 50px !important; /* Bentuk Pill/Kapsul */\r\n padding: 10px 20px !important;\r\n margin: 0 !important;\r\n font-weight: 600 !important;\r\n font-size: 0.9rem !important;\r\n color: var(--text-muted) !important;\r\n transition: all 0.2s var(--ease-spring) !important;\r\n text-transform: none !important;\r\n text-decoration: none !important;\r\n}\r\n\r\n/* Hover State */\r\na.tmenu:hover {\r\n background-color: var(--primary-soft) !important;\r\n color: var(--primary) !important;\r\n}\r\n\r\n/* Active State */\r\na.tmenusel {\r\n background-color: var(--primary) !important;\r\n color: #ffffff !important;\r\n box-shadow: 0 4px 12px rgba(59, 130, 246, 0.3) !important; /* Glow Effect */\r\n}\r\n\r\n/* --- 4. SIDEBAR NAVIGATION (HIERARCHY & CLEAN) --- */\r\ndiv.vmenu {\r\n margin-top: 20px !important;\r\n background: transparent !important;\r\n border: none !important;\r\n padding-right: 12px !important;\r\n}\r\n\r\n/* Judul Kategori (Commercial, Projects, etc) */\r\n.vmenu .titre {\r\n font-size: 0.75rem !important;\r\n font-weight: 800 !important;\r\n text-transform: uppercase !important;\r\n letter-spacing: 0.1em !important;\r\n color: #94a3b8 !important; /* Light Slate */\r\n margin: 20px 0 8px 20px !important;\r\n padding: 0 !important;\r\n background: transparent !important;\r\n border: none !important;\r\n}\r\n\r\n/* Container Submenu */\r\n.vmenu .menu_contenu {\r\n padding: 0 !important;\r\n background: transparent !important;\r\n position: relative;\r\n margin-left: 20px !important; /* Indentasi */\r\n border-left: 1px solid #e2e8f0 !important; /* Garis Panduan Hierarki */\r\n}\r\n\r\n/* Item Menu Sidebar */\r\na.vmenu {\r\n display: flex !important;\r\n align-items: center;\r\n padding: 10px 16px !important;\r\n margin: 2px 0 2px 10px !important; /* Jarak dari garis kiri */\r\n border-radius: var(--radius-md) !important;\r\n font-weight: 500 !important;\r\n color: var(--text-main) !important;\r\n text-decoration: none !important;\r\n transition: all 0.2s var(--ease-spring) !important;\r\n background: transparent !important;\r\n}\r\n\r\n/* Sidebar Hover - Slide Effect */\r\na.vmenu:hover {\r\n background-color: var(--bg-surface) !important;\r\n color: var(--primary) !important;\r\n transform: translateX(5px); /* Geser kanan sedikit */\r\n box-shadow: var(--shadow-sm) !important;\r\n}\r\n\r\n/* Sidebar Active */\r\na.vmenusel {\r\n background-color: var(--bg-surface) !important;\r\n color: var(--primary) !important;\r\n font-weight: 700 !important;\r\n border-left: 3px solid var(--primary) !important; /* Penanda Aktif */\r\n box-shadow: var(--shadow-sm) !important;\r\n}\r\n\r\n/* Hide Old Icons if needed for cleaner look */\r\n/* a.vmenu img { display: none !important; } */ \r\n\r\n/* --- 5. MAIN CONTENT CARDS (FLOATING UI) --- */\r\ndiv.fiche, .fichecenter, .tabBar {\r\n background: var(--bg-surface) !important;\r\n border: 1px solid white !important; /* Hilangkan border abu-abu */\r\n border-radius: var(--radius-xl) !important;\r\n box-shadow: var(--shadow-card) !important;\r\n margin: 0 0 30px 0 !important;\r\n padding: 30px !important; /* Whitespace lega */\r\n}\r\n\r\n/* Judul Halaman */\r\nh1, .titre {\r\n font-weight: 800 !important;\r\n color: #0f172a !important;\r\n font-size: 1.6rem !important;\r\n letter-spacing: -0.03em !important;\r\n margin-bottom: 25px !important;\r\n background: transparent !important;\r\n text-shadow: none !important;\r\n}\r\n\r\n/* --- 6. MODERN TABLE (LIST VIEW) --- */\r\ntable.liste {\r\n width: 100% !important;\r\n border-collapse: separate !important; /* Penting untuk rounded corners row */\r\n border-spacing: 0 4px !important; /* Jarak antar baris */\r\n background: transparent !important;\r\n border: none !important;\r\n}\r\n\r\n/* Header Tabel */\r\ntable.liste tr.liste_titre {\r\n background: transparent !important;\r\n}\r\n\r\ntable.liste th, table.liste tr.liste_titre td {\r\n border: none !important;\r\n border-bottom: 1px solid var(--border-subtle) !important;\r\n padding: 15px !important;\r\n font-size: 0.75rem !important;\r\n text-transform: uppercase;\r\n color: var(--text-muted) !important;\r\n font-weight: 700 !important;\r\n letter-spacing: 0.05em;\r\n}\r\n\r\n/* Body Rows */\r\ntable.liste tr:not(.liste_titre) {\r\n background: var(--bg-surface) !important;\r\n transition: transform 0.2s, box-shadow 0.2s;\r\n}\r\n\r\ntable.liste td {\r\n padding: 16px 20px !important;\r\n border: none !important;\r\n vertical-align: middle !important;\r\n}\r\n\r\n/* Row Styling (Card effect per baris) */\r\ntable.liste tr:not(.liste_titre) td:first-child { border-top-left-radius: var(--radius-md); border-bottom-left-radius: var(--radius-md); }\r\ntable.liste tr:not(.liste_titre) td:last-child { border-top-right-radius: var(--radius-md); border-bottom-right-radius: var(--radius-md); }\r\n\r\n/* Hover Row Effect */\r\ntable.liste tr:not(.liste_titre):hover {\r\n transform: scale(1.005);\r\n background-color: #fff !important;\r\n box-shadow: var(--shadow-card) !important;\r\n z-index: 10;\r\n position: relative;\r\n}\r\n\r\n/* Hapus Striping Zebra Lama */\r\n.impair, .pair { background: var(--bg-surface) !important; }\r\n\r\n/* --- 7. BUTTONS & ACTIONS --- */\r\n.button, .butAction, .butActionDelete, button {\r\n border-radius: var(--radius-md) !important;\r\n padding: 10px 24px !important;\r\n font-weight: 600 !important;\r\n font-size: 0.9rem !important;\r\n text-transform: none !important;\r\n letter-spacing: normal !important;\r\n transition: all 0.2s var(--ease-spring) !important;\r\n box-shadow: var(--shadow-sm) !important;\r\n border: 1px solid var(--border-subtle) !important;\r\n background-image: none !important;\r\n}\r\n\r\n/* Primary Action */\r\n.butAction {\r\n background-color: var(--primary) !important;\r\n border-color: var(--primary) !important;\r\n color: white !important;\r\n}\r\n\r\n/* Hover Interactions */\r\n.butAction:hover {\r\n background-color: var(--primary-hover) !important;\r\n box-shadow: 0 4px 12px rgba(59, 130, 246, 0.4) !important;\r\n transform: translateY(-2px);\r\n}\r\n\r\n.button:hover, .butActionDelete:hover {\r\n background-color: #f8fafc !important;\r\n transform: translateY(-2px);\r\n}\r\n\r\n/* --- 8. FORMS & INPUTS --- */\r\ninput:not([type=submit]):not([type=button]):not([type=checkbox]), textarea, select, .flat {\r\n background-color: #f8fafc !important;\r\n border: 1px solid var(--border-subtle) !important;\r\n border-radius: var(--radius-md) !important;\r\n padding: 12px !important;\r\n font-size: 0.95rem !important;\r\n box-shadow: none !important;\r\n transition: border 0.2s, box-shadow 0.2s;\r\n}\r\n\r\ninput:focus, textarea:focus, select:focus {\r\n background-color: #fff !important;\r\n border-color: var(--primary) !important;\r\n outline: none !important;\r\n box-shadow: 0 0 0 4px var(--primary-soft) !important;\r\n}\r\n\r\n/* Select2 Fix (Jika ada) */\r\n.select2-container .select2-selection--single {\r\n height: 42px !important;\r\n border: 1px solid var(--border-subtle) !important;\r\n border-radius: var(--radius-md) !important;\r\n padding-top: 6px;\r\n background-color: #f8fafc !important;\r\n}\r
