2026-02-05 04:08:11 DEBUG   ::1                8940         sql=INSERT INTO llx_const(name, value, type, visible, note, entity) VALUES ('MAIN_IHM_CUSTOM_CSS', '/* ==========================================================================\r\n 1. DESIGN TOKENS & TYPOGRAPHY SYSTEM\r\n ========================================================================== */\r\n@import url(\'https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap\');\r\n\r\n:root {\r\n /* Brand Palette */\r\n --brand-primary: #843523; /* Deep Elegant Brown */\r\n --brand-secondary: #BFA584; /* Soft Gold/Beige */\r\n --brand-accent: #a04936; /* Lighter Brown for hover */\r\n \r\n /* Neutral & Backgrounds */\r\n --bg-body: #FDFCFB; /* Warm Off-white */\r\n --bg-card: #FFFFFF;\r\n --text-main: #2d2d2d;\r\n --text-muted: #6b7280;\r\n \r\n /* Glassmorphism Variables */\r\n --glass-bg: rgba(255, 255, 255, 0.65);\r\n --glass-border: rgba(255, 255, 255, 0.4);\r\n --glass-blur: blur(16px);\r\n \r\n /* Depth & Elevation (Layered Shadows) */\r\n --shadow-sm: 0 2px 8px rgba(132, 53, 35, 0.04);\r\n --shadow-md: 0 12px 24px -6px rgba(132, 53, 35, 0.08), 0 4px 8px -4px rgba(0, 0, 0, 0.02);\r\n --shadow-lg: 0 20px 40px -8px rgba(132, 53, 35, 0.12);\r\n \r\n /* Layout */\r\n --radius-lg: 16px;\r\n --radius-md: 12px;\r\n --radius-sm: 8px;\r\n --transition-smooth: all 0.4s cubic-bezier(0.25, 0.8, 0.25, 1);\r\n}\r\n\r\n/* Global Reset & Font */\r\nbody, button, input, select, textarea, .tmenulabel, .vmenu {\r\n font-family: \'Plus Jakarta Sans\', sans-serif !important;\r\n -webkit-font-smoothing: antialiased;\r\n color: var(--text-main);\r\n background-color: var(--bg-body) !important;\r\n}\r\n\r\n/* ==========================================================================\r\n 2. GLASSMORPHISM NAVIGATION (Navbar & Sidebar)\r\n ========================================================================== */\r\n\r\n/* Top Navigation Bar */\r\ndiv.tmenudiv {\r\n background: var(--glass-bg) !important;\r\n backdrop-filter: var(--glass-blur);\r\n -webkit-backdrop-filter: var(--glass-blur);\r\n border-bottom: 1px solid rgba(132, 53, 35, 0.08);\r\n height: 64px !important;\r\n box-shadow: var(--shadow-sm);\r\n display: flex;\r\n align-items: center;\r\n}\r\n\r\n/* Menu Items Spacing & Styling */\r\ndiv.tmenudiv .tmenulabel {\r\n margin: 0 18px !important; /* Spacing antar menu */\r\n font-weight: 600 !important;\r\n font-size: 0.95rem !important;\r\n color: var(--text-muted) !important;\r\n padding: 8px 16px;\r\n border-radius: var(--radius-md);\r\n transition: var(--transition-smooth);\r\n}\r\n\r\ndiv.tmenudiv .tmenulabel:hover {\r\n color: var(--brand-primary) !important;\r\n background: rgba(132, 53, 35, 0.05);\r\n transform: translateY(-2px);\r\n}\r\n\r\n/* Active Menu State */\r\ndiv.tmenudiv .tmenulabel.tmenulabelsel {\r\n color: var(--brand-primary) !important;\r\n background: rgba(191, 165, 132, 0.15) !important; /* Soft Gold bg */\r\n box-shadow: 0 4px 12px rgba(191, 165, 132, 0.2);\r\n}\r\n\r\n/* Sidebar (Left Menu) */\r\ndiv.side-nav {\r\n background: var(--glass-bg) !important;\r\n backdrop-filter: var(--glass-blur);\r\n border-right: 1px solid rgba(132, 53, 35, 0.08);\r\n box-shadow: 4px 0 24px rgba(0,0,0,0.02);\r\n}\r\n\r\n/* Sidebar Items */\r\n.vmenu .vmenuentry {\r\n margin-bottom: 8px;\r\n border-radius: 0 24px 24px 0; /* Rounded right side only */\r\n transition: var(--transition-smooth);\r\n padding: 10px 15px !important;\r\n}\r\n\r\n.vmenu .vmenuentry:hover {\r\n background: linear-gradient(90deg, rgba(132, 53, 35, 0.05) 0%, transparent 100%);\r\n padding-left: 20px !important; /* Subtle movement right */\r\n}\r\n\r\n/* Sidebar Links */\r\na.vmenu {\r\n font-weight: 500 !important;\r\n color: var(--text-muted) !important;\r\n}\r\n\r\n/* Active Sidebar Item */\r\n.vmenu .vmenuentry.vmenuentrysel {\r\n background: linear-gradient(90deg, var(--brand-primary) 0%, var(--brand-accent) 100%) !important;\r\n box-shadow: 4px 4px 15px rgba(132, 53, 35, 0.3);\r\n color: white !important;\r\n}\r\n\r\n.vmenu .vmenuentry.vmenuentrysel a.vmenu {\r\n color: white !important;\r\n font-weight: 700 !important;\r\n}\r\n\r\n/* ==========================================================================\r\n 3. MODERN CARDS & CONTAINERS\r\n ========================================================================== */\r\n\r\n/* Main Card Styling */\r\ndiv.fiche, div.card, .box, .box-stats {\r\n border: none !important;\r\n background: var(--bg-card) !important;\r\n border-radius: var(--radius-lg) !important;\r\n box-shadow: var(--shadow-md) !important;\r\n margin-bottom: 24px !important;\r\n padding: 24px !important;\r\n transition: var(--transition-smooth);\r\n}\r\n\r\n/* Hover Effect on Cards (Subtle Lift) */\r\ndiv.fiche:hover, .box:hover {\r\n transform: translateY(-4px);\r\n box-shadow: var(--shadow-lg) !important;\r\n}\r\n\r\n/* Tabs (Replacing the old folder look) */\r\ndiv.tabs {\r\n border-bottom: 2px solid #eee !important;\r\n margin-bottom: 20px;\r\n display: flex;\r\n gap: 10px;\r\n}\r\n\r\ndiv.tabs a.tabTitle {\r\n background: transparent !important;\r\n border: none !important;\r\n border-bottom: 3px solid transparent !important;\r\n color: var(--text-muted) !important;\r\n font-weight: 600 !important;\r\n padding: 12px 20px !important;\r\n margin: 0 !important;\r\n border-radius: 6px 6px 0 0;\r\n opacity: 0.7;\r\n transition: var(--transition-smooth);\r\n}\r\n\r\ndiv.tabs a.tabTitle.tabTitleActive {\r\n border-bottom: 3px solid var(--brand-primary) !important;\r\n color: var(--brand-primary) !important;\r\n opacity: 1;\r\n background: rgba(132, 53, 35, 0.02) !important;\r\n}\r\n\r\n/* ==========================================================================\r\n 4. EPIC TABLE UI (Odoo List View Style)\r\n ========================================================================== */\r\n\r\n/* Table Container */\r\n.div-table-responsive, table.liste {\r\n border-radius: var(--radius-md);\r\n overflow: hidden;\r\n border: none !important;\r\n}\r\n\r\ntable.liste {\r\n width: 100%;\r\n border-collapse: separate; \r\n border-spacing: 0 8px; /* Spacing between rows like cards */\r\n background: transparent !important;\r\n}\r\n\r\n/* Header */\r\ntable.liste tr.liste_titre th, table.liste tr.liste_titre td {\r\n background: transparent !important;\r\n border: none !important;\r\n border-bottom: 1px solid #e5e7eb !important;\r\n color: var(--text-muted) !important;\r\n text-transform: uppercase;\r\n font-size: 0.75rem;\r\n font-weight: 700;\r\n letter-spacing: 0.05em;\r\n padding: 16px !important;\r\n}\r\n\r\n/* Table Rows */\r\ntable.liste tr {\r\n background: var(--bg-card) !important;\r\n box-shadow: var(--shadow-sm);\r\n border-radius: var(--radius-sm);\r\n transition: var(--transition-smooth);\r\n}\r\n\r\n/* Content Cells */\r\ntable.liste td {\r\n border: none !important;\r\n padding: 16px !important;\r\n vertical-align: middle !important;\r\n color: var(--text-main);\r\n border-top: 1px solid transparent;\r\n border-bottom: 1px solid transparent;\r\n}\r\n\r\n/* First and Last child border radius for \"Card Row\" look */\r\ntable.liste tr td:first-child {\r\n border-top-left-radius: var(--radius-sm);\r\n border-bottom-left-radius: var(--radius-sm);\r\n}\r\ntable.liste tr td:last-child {\r\n border-top-right-radius: var(--radius-sm);\r\n border-bottom-right-radius: var(--radius-sm);\r\n}\r\n\r\n/* Hover Effect on Rows */\r\ntable.liste tr:not(.liste_titre):hover td {\r\n background-color: #FFF8F6 !important; /* Very light tint of brand color */\r\n transform: scale(1.005);\r\n cursor: pointer;\r\n}\r\n\r\n/* Remove Zebra Striping for cleaner look */\r\n.pair, .impair {\r\n background-color: var(--bg-card) !important;\r\n}\r\n\r\n/* ==========================================================================\r\n 5. BUTTONS & ACTIONS (Flawless Interaction)\r\n ========================================================================== */\r\n\r\n.button, .butAction {\r\n background: var(--brand-primary) !important;\r\n color: #fff !important;\r\n border: none !important;\r\n border-radius: 50px !important; /* Pill shape */\r\n padding: 10px 24px !important;\r\n font-weight: 600 !important;\r\n font-size: 0.9rem !important;\r\n box-shadow: 0 4px 10px rgba(132, 53, 35, 0.3);\r\n transition: var(--transition-smooth);\r\n text-transform: uppercase;\r\n letter-spacing: 0.5px;\r\n background-image: none !important;\r\n}\r\n\r\n.button:hover, .butAction:hover {\r\n background: var(--brand-accent) !important;\r\n transform: translateY(-2px);\r\n box-shadow: 0 8px 15px rgba(132, 53, 35, 0.4);\r\n}\r\n\r\n.button:active {\r\n transform: translateY(0);\r\n}\r\n\r\n/* Secondary Actions */\r\n.butActionRefused, .buttonRefused {\r\n background: transparent !important;\r\n border: 2px solid var(--brand-secondary) !important;\r\n color: var(--brand-secondary) !important;\r\n box-shadow: none !important;\r\n}\r\n\r\n/* ==========================================================================\r\n 6. FORMS & INPUTS\r\n ========================================================================== */\r\n\r\ninput[type=\"text\"], input[type=\"password\"], select, textarea {\r\n border: 2px solid #e5e7eb !important;\r\n border-radius: var(--radius-sm) !important;\r\n padding: 10px 14px !important;\r\n background-color: #f9fafb !important;\r\n transition: var(--transition-smooth);\r\n font-size: 0.95rem;\r\n}\r\n\r\ninput:focus, select:focus, textarea:focus {\r\n border-color: var(--brand-secondary) !important;\r\n background-color: #fff !important;\r\n box-shadow: 0 0 0 4px rgba(191, 165, 132, 0.2) !important; /* Gold ring focus */\r\n outline: none;\r\n}\r\n\r\n/* ==========================================================================\r\n 7. UTILITIES & CLEANUP\r\n ========================================================================== */\r\n\r\n/* Login/Profile Block */\r\n.login_block {\r\n background: transparent !important;\r\n border: none !important;\r\n}\r\n\r\n.login_block a {\r\n color: var(--brand-primar
