0;\r\n left: 0;\r\n width: 100%;\r\n height: 3px;\r\n background: var(--primary);\r\n border-radius: 3px 3px 0 0;\r\n}\r\n\r\n.mainmenuaspan {\r\n font-weight: 600 !important;\r\n color: var(--text-main) !important;\r\n font-size: 0.9em;\r\n text-transform: uppercase;\r\n letter-spacing: 0.5px;\r\n}\r\n\r\n/* 2. SIDEBAR (Clean & Airy) */\r\n.side-nav {\r\n background: var(--bg-sidebar) !important;\r\n border-right: 1px solid var(--border-light);\r\n box-shadow: none !important;\r\n padding-top: 20px;\r\n width: var(--sidebar-width);\r\n transition: width 0.3s ease;\r\n}\r\n\r\n/* Sidebar Links */\r\na.vmenu, a.vsmenu {\r\n color: var(--text-muted) !important;\r\n padding: 12px 20px !important;\r\n margin: 4px 12px !important;\r\n border-radius: 8px;\r\n display: block;\r\n transition: all 0.2s ease;\r\n font-weight: 500 !important;\r\n border: none !important;\r\n}\r\n\r\n/* Sidebar Hover/Active */\r\na.vmenu:hover, a.vsmenu:hover, .blockvmenuimpair a:hover {\r\n background-color: #f8fafc !important;\r\n color: var(--primary) !important;\r\n transform: translateX(5px);\r\n}\r\n\r\n.blockvmenupair, .blockvmenuimpair {\r\n background: transparent !important;\r\n border-bottom: none !important;\r\n margin-bottom: 5px;\r\n}\r\n\r\ndiv.blockvmenulogo {\r\n border: none !important;\r\n text-align: center;\r\n margin-bottom: 20px;\r\n}\r\n\r\n/* 3. MAIN CONTENT AREA (The \"Paper\" Effect) */\r\n#id-right {\r\n padding: 30px !important;\r\n transition: margin-left 0.3s ease;\r\n}\r\n\r\n/* Card Container (.fiche) */\r\ndiv.fiche {\r\n background: var(--bg-surface);\r\n border-radius: var(--radius-card);\r\n box-shadow: var(--shadow-card);\r\n border: 1px solid var(--border-light);\r\n padding: 30px !important;\r\n margin-bottom: 30px !important;\r\n margin-left: 0 !important;\r\n margin-right: 0 !important;\r\n \r\n /* Animation fade in */\r\n animation: fadeIn 0.5s ease-out;\r\n}\r\n\r\n@keyframes fadeIn {\r\n from { opacity: 0; transform: translateY(10px); }\r\n to { opacity: 1; transform: translateY(0); }\r\n}\r\n\r\n/* Title on Cards */\r\ndiv.titre {\r\n font-size: 1.5rem !important;\r\n font-weight: 700 !important;\r\n color: var(--text-main) !important;\r\n margin-bottom: 25px;\r\n padding-bottom: 15px;\r\n border-bottom: 1px solid var(--border-light);\r\n text-transform: none !important;\r\n}\r\n\r\n/* ------------------------------------------------------------------- */\r\n/* COMPONENTS & UI ELEMENTS */\r\n/* ------------------------------------------------------------------- */\r\n\r\n/* 1. TABS (Modern Pills style) */\r\ndiv.tabs {\r\n margin-bottom: 0 !important;\r\n padding-left: 10px;\r\n}\r\n\r\ndiv.tabBar {\r\n background: transparent !important;\r\n border: none !important;\r\n padding: 0 !important;\r\n margin-bottom: 20px;\r\n}\r\n\r\na.tab {\r\n background: transparent !important;\r\n border: none !important;\r\n color: var(--text-muted) !important;\r\n font-weight: 600 !important;\r\n padding: 10px 20px !important;\r\n border-bottom: 2px solid transparent !important;\r\n transition: all 0.3s ease;\r\n}\r\n\r\na.tab:hover {\r\n color: var(--primary) !important;\r\n background: transparent !important;\r\n}\r\n\r\na.tab#active {\r\n color: var(--primary) !important;\r\n border-bottom: 2px solid var(--primary) !important;\r\n background: transparent !important;\r\n}\r\n\r\n/* 2. BUTTONS (Vibrant & Tactile) */\r\n.button, .butAction, .butActionDelete {\r\n background: var(--primary) !important;\r\n color: white !important;\r\n border: none !important;\r\n border-radius: var(--radius-btn) !important;\r\n padding: 10px 24px !important;\r\n font-size: 0.95em !important;\r\n font-weight: 600 !important;\r\n text-transform: none !important;\r\n box-shadow: 0 4px 6px rgba(79, 70, 229, 0.2);\r\n transition: transform 0.1s ease, box-shadow 0.2s ease !important;\r\n cursor: pointer;\r\n background-image: none !important;\r\n}\r\n\r\n.button:hover, .butAction:hover {\r\n background: var(--primary-hover) !important;\r\n box-shadow: 0 6px 10px rgba(79, 70, 229, 0.3);\r\n transform: translateY(-2px);\r\n}\r\n\r\n.button:active {\r\n transform: translateY(0);\r\n}\r\n\r\n/* Delete/Cancel Buttons */\r\n.buttonDelete, .butActionDelete {\r\n background: #fff !important;\r\n color: var(--danger) !important;\r\n border: 1px solid var(--danger) !important;\r\n box-shadow: none !important;\r\n}\r\n\r\n.buttonDelete:hover {\r\n background: var(--danger) !important;\r\n color: white !important;\r\n box-shadow: 0 4px 6px rgba(239, 68, 68, 0.2) !important;\r\n}\r\n\r\n/* 3. FORMS & INPUTS (SaaS Style) */\r\ninput[type=\"text\"], \r\ninput[type=\"password\"], \r\ninput[type=\"email\"], \r\nselect, \r\ntextarea {\r\n background: #fff !important;\r\n border: 1px solid var(--border-light) !important;\r\n border-radius: 8px !important;\r\n padding: 10px 14px !important;\r\n font-size: 14px !important;\r\n color: var(--text-main) !important;\r\n transition: all 0.2s ease;\r\n box-shadow: 0 1px 2px rgba(0,0,0,0.05) inset;\r\n min-height: 40px;\r\n}\r\n\r\ninput:focus, select:focus, textarea:focus {\r\n border-color: var(--primary) !important;\r\n box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.1) !important;\r\n outline: none;\r\n}\r\n\r\n/* Select2 Modernization */\r\n.select2-container .select2-selection--single {\r\n height: 40px !important;\r\n border: 1px solid var(--border-light) !important;\r\n border-radius: 8px !important;\r\n display: flex;\r\n align-items: center;\r\n}\r\n.select2-container--default .select2-selection--single .select2-selection__rendered {\r\n line-height: 40px !important;\r\n padding-left: 14px !important;\r\n}\r\n\r\n/* 4. TABLES (Odoo List View Style) */\r\ntable.liste {\r\n border-collapse: separate;\r\n border-spacing: 0;\r\n width: 100%;\r\n border: 1px solid var(--border-light);\r\n border-radius: 12px;\r\n overflow: hidden;\r\n margin-bottom: 20px;\r\n}\r\n\r\n/* Table Header */\r\ntr.liste_titre {\r\n background: #f8fafc !important;\r\n height: 50px !important;\r\n}\r\n\r\ntr.liste_titre th, tr.liste_titre td {\r\n font-weight: 600 !important;\r\n color: var(--text-muted) !important;\r\n text-transform: uppercase;\r\n font-size: 0.75rem !important;\r\n letter-spacing: 0.05em;\r\n padding: 15px 20px !important;\r\n border-bottom: 1px solid var(--border-light) !important;\r\n border-right: none !important;\r\n border-top: none !important;\r\n}\r\n\r\n/* Table Body */\r\ntr.oddeven, tr.evenodd, tr.impair, tr.pair {\r\n background: #fff !important;\r\n transition: background-color 0.2s ease;\r\n}\r\n\r\ntable.liste td {\r\n padding: 16px 20px !important;\r\n border-bottom: 1px solid var(--border-light);\r\n border-right: none !important;\r\n color: var(--text-main);\r\n font-size: 0.95rem;\r\n height: auto !important;\r\n}\r\n\r\n/* Row Hover Effect */\r\ntable.liste tr:hover td {\r\n background-color: #f1f5f9 !important;\r\n}\r\n\r\n/* Remove vertical lines */\r\n.liste td, .liste th {\r\n border-left: none !important;\r\n border-right: none !important;\r\n}\r\n\r\n/* 5. BADGES & STATUS (Pill Shape) */\r\n.badge {\r\n border-radius: 50px !important;\r\n padding: 4px 12px !important;\r\n font-size: 0.75rem !important;\r\n font-weight: 700 !important;\r\n text-transform: uppercase;\r\n}\r\n\r\n.badge-status-1 { background: #dcfce7 !important; color: #166534 !important; } /* Success */\r\n.badge-status-0 { background: #fee2e2 !important; color: #991b1b !important; } /* Error */\r\n.badge-status-draft { background: #f3f4f6 !important; color: #374151 !important; border: 1px solid #d1d5db; }\r\n\r\n/* ------------------------------------------------------------------- */\r\n/* SPECIAL PAGES: LOGIN (SaaS Style) */\r\n/* ------------------------------------------------------------------- */\r\n\r\n.bodylogin {\r\n background: linear-gradient(135deg, #f8fafc 0%, #e2e8f0 100%) !important;\r\n display: flex;\r\n align-items: center;\r\n justify-content: center;\r\n min-height: 100vh;\r\n}\r\n\r\n.login_table {\r\n background: #fff !important;\r\n border: