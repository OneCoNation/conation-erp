2026-02-05 06:46:33 DEBUG   ::1                8940         sql=INSERT INTO llx_const(name, value, type, visible, note, entity) VALUES ('MAIN_IHM_CUSTOM_CSS', '/* =========================================\r\n DOLIBARR MODERN PRO - UPGRADE PACK\r\n Feature: Glassmorphism, Dashboard Grid, Elegant Menu\r\n ========================================= */\r\n\r\n/* --- A. UPGRADE BACKGROUND (Wajib untuk Efek Glass) --- */\r\nbody {\r\n /* Background Gradient Abstrak Halus */\r\n background: \r\n radial-gradient(at 0% 0%, hsla(253,16%,7%,0) 0, hsla(253,16%,7%,0) 50%), \r\n radial-gradient(at 50% 0%, hsla(225,39%,30%,0.1) 0, hsla(225,39%,30%,0) 50%), \r\n radial-gradient(at 100% 0%, hsla(339,49%,30%,0.1) 0, hsla(339,49%,30%,0) 50%),\r\n var(--bg-body) !important;\r\n background-attachment: fixed; /* Efek Parallax sederhana saat scroll */\r\n background-size: cover;\r\n}\r\n\r\n/* --- B. DASHBOARD WIDGETS (GLASSMORPHISM STYLE) --- */\r\n\r\n/* Container Utama Widget Dashboard */\r\n.box, div.fiche, .tabBar {\r\n /* Latar belakang semi-transparan (Kunci Glassmorphism) */\r\n background: rgba(255, 255, 255, 0.75) !important; \r\n \r\n /* Efek Blur di belakang objek */\r\n backdrop-filter: blur(16px) saturate(180%);\r\n -webkit-backdrop-filter: blur(16px) saturate(180%);\r\n \r\n /* Border tipis putih agar terlihat seperti kaca tebal */\r\n border: 1px solid rgba(255, 255, 255, 0.6) !important;\r\n border-top: 1px solid rgba(255, 255, 255, 0.9) !important; /* Highlight atas */\r\n \r\n /* Shadow yang lebih diffuse/menyebar */\r\n box-shadow: \r\n 0 4px 6px -1px rgba(0, 0, 0, 0.02), \r\n 0 10px 15px -3px rgba(0, 0, 0, 0.05),\r\n inset 0 0 20px rgba(255,255,255,0.5) !important; /* Inner glow */\r\n \r\n border-radius: var(--radius-lg) !important;\r\n margin-bottom: 30px !important;\r\n}\r\n\r\n/* Judul Widget Dashboard */\r\n.box_titre {\r\n background: transparent !important;\r\n border-bottom: 1px solid rgba(0,0,0,0.05) !important;\r\n color: var(--primary-color) !important;\r\n font-size: 1.15rem;\r\n padding: 15px 0 15px 0 !important;\r\n display: flex;\r\n align-items: center;\r\n position: relative;\r\n}\r\n\r\n/* Hiasan kecil di bawah judul widget (Garis indikator) */\r\n.box_titre::after {\r\n content: \'\';\r\n position: absolute;\r\n bottom: -1px;\r\n left: 0;\r\n width: 40px;\r\n height: 3px;\r\n background: var(--primary-color);\r\n border-radius: 10px;\r\n}\r\n\r\n/* Isi Widget - Agar tabel di dalamnya transparan */\r\n.box table.liste, .box tr.liste_titre, .box tr.pair, .box tr.impair {\r\n background: transparent !important;\r\n}\r\n\r\n/* Hover Effect pada Widget (Floating) */\r\n.box:hover {\r\n transform: translateY(-8px) scale(1.005);\r\n box-shadow: \r\n 0 20px 25px -5px rgba(0, 0, 0, 0.1), \r\n 0 8px 10px -6px rgba(0, 0, 0, 0.1) !important;\r\n border-color: rgba(255, 255, 255, 0.9) !important;\r\n z-index: 10;\r\n}\r\n\r\n/* Ikon Dashboard (Cuaca, User, dsb) agar lebih pop-up */\r\n.ico {\r\n filter: drop-shadow(0 4px 3px rgba(0,0,0,0.1));\r\n transition: transform 0.3s ease;\r\n}\r\n.box:hover .ico {\r\n transform: scale(1.1) rotate(5deg);\r\n}\r\n\r\n/* --- C. SIDEBAR & SUB-MENU (ELEGANT TREE STYLE) --- */\r\n\r\n/* Container Menu Kiri */\r\ndiv.vmenu {\r\n padding-left: 10px;\r\n}\r\n\r\n/* 1. Kategori Menu (Header) */\r\n.vmenu .titre {\r\n color: var(--primary-color) !important;\r\n font-size: 0.7rem;\r\n background: rgba(99, 102, 241, 0.08) !important; /* Kotak tipis di header */\r\n padding: 8px 12px;\r\n border-radius: 8px;\r\n margin: 25px 15px 10px 0;\r\n display: inline-block;\r\n letter-spacing: 0.15em;\r\n}\r\n\r\n/* 2. Item Menu (Link) - Style Baru */\r\na.vmenu {\r\n position: relative;\r\n margin: 2px 15px 2px 5px; /* Sedikit indent */\r\n padding: 12px 15px 12px 25px !important; /* Padding kiri lebih besar untuk garis */\r\n border-radius: 12px;\r\n border-left: none !important; /* Hapus border lama */\r\n color: var(--text-muted) !important;\r\n font-size: 0.92rem;\r\n background: transparent !important;\r\n overflow: hidden; /* Untuk efek ripple */\r\n}\r\n\r\n/* Garis Konektor Vertikal (Tree Line) */\r\na.vmenu::before {\r\n content: \'\';\r\n position: absolute;\r\n left: 10px;\r\n top: 50%;\r\n transform: translateY(-50%);\r\n height: 6px;\r\n width: 6px;\r\n border-radius: 50%;\r\n background-color: #cbd5e1; /* Titik abu-abu */\r\n transition: all 0.3s ease;\r\n}\r\n\r\n/* Hover State Menu */\r\na.vmenu:hover {\r\n background: #fff !important;\r\n color: var(--primary-color) !important;\r\n transform: translateX(8px); /* Geser ke kanan lebih jauh */\r\n box-shadow: 5px 0 15px -3px rgba(99, 102, 241, 0.15);\r\n}\r\n\r\n/* Titik berubah jadi Garis Panjang saat Hover */\r\na.vmenu:hover::before {\r\n background-color: var(--primary-color);\r\n height: 18px; /* Memanjang vertikal */\r\n border-radius: 10px;\r\n box-shadow: 0 0 8px var(--primary-light);\r\n}\r\n\r\n/* Active State (Menu yang sedang dibuka) */\r\na.vmenu.active {\r\n background: linear-gradient(90deg, #fff, #f3f4f6) !important;\r\n color: var(--primary-color) !important;\r\n font-weight: 700;\r\n box-shadow: inset -3px 0 0 var(--primary-color); /* Garis indikator di KANAN */\r\n}\r\n\r\na.vmenu.active::before {\r\n background-color: var(--primary-color);\r\n height: 6px;\r\n width: 6px;\r\n box-shadow: 0 0 10px var(--primary-color); /* Glowing dot */\r\n}\r\n\r\n/* --- D. RESPONSIVE DASHBOARD ALIGNMENT --- */\r\n/* Membuat widget dashboard tampil 2 kolom di layar lebar jika memungkinkan */\r\n@media screen and (min-width: 1200px) {\r\n .fiche > table > tbody > tr > td {\r\n display: block;\r\n width: 100%;\r\n }\r\n \r\n /* Grid layout simulation for box containers inside main dashboard */\r\n .fiche .ui-sortable {\r\n display: grid;\r\n grid-template-columns: repeat(auto-fit, minmax(450px, 1fr));\r\n gap: 25px;\r\n }\r\n \r\n /* Pastikan box mengisi grid */\r\n .box {\r\n margin-bottom: 0 !important;\r\n height: 100%; /* Agar tinggi seragam */\r\n }\r\n}', 'chaine', 0, '', 1)
