2026-02-05 04:10:29 DEBUG   ::1                8940         sql=INSERT INTO llx_const(name, value, type, visible, note, entity) VALUES ('MAIN_IHM_CUSTOM_CSS', '/* ==========================================================================\r\n 1. CORE VARIABLES & TYPOGRAPHY OVERRIDE\r\n ========================================================================== */\r\n@import url(\'https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap\');\r\n\r\n:root {\r\n /* Brand Colors - Forced */\r\n --brand-primary: #843523; \r\n --brand-secondary: #BFA584; \r\n --brand-accent: #a04936; \r\n \r\n /* System Colors */\r\n --bg-body: #FDFCFB; \r\n --bg-card: #FFFFFF;\r\n --text-main: #2d2d2d;\r\n --text-muted: #6b7280;\r\n \r\n /* Glass Effect */\r\n --glass-bg: rgba(255, 255, 255, 0.75);\r\n --glass-blur: blur(20px);\r\n \r\n /* Layout */\r\n --radius-lg: 16px;\r\n --radius-pill: 50px;\r\n}\r\n\r\n/* Force Font Family Everywhere */\r\nbody, table, td, div, span, input, select, textarea, button, h1, h2, h3, h4, h5, h6, .tmenulabel, .vmenu {\r\n font-family: \'Plus Jakarta Sans\', sans-serif !important;\r\n -webkit-font-smoothing: antialiased !important;\r\n}\r\n\r\n/* Background Body Reset */\r\nbody {\r\n background: var(--bg-body) !important;\r\n color: var(--text-main) !important;\r\n}\r\n\r\n/* ==========================================================================\r\n 2. GLASSMORPHISM HEADER (NAVBAR)\r\n ========================================================================== */\r\n\r\ndiv.tmenudiv {\r\n background: var(--glass-bg) !important;\r\n backdrop-filter: var(--glass-blur) !important;\r\n -webkit-backdrop-filter: var(--glass-blur) !important;\r\n border-bottom: 1px solid rgba(132, 53, 35, 0.08) !important;\r\n height: 68px !important; /* Sedikit lebih tinggi */\r\n box-shadow: 0 4px 20px rgba(0,0,0,0.03) !important;\r\n background-image: none !important; /* Kill default gradient */\r\n}\r\n\r\n/* Menu Item Styling */\r\ndiv.tmenudiv .tmenulabel {\r\n margin: 0 12px !important;\r\n padding: 8px 18px !important;\r\n border-radius: 12px !important;\r\n color: var(--text-muted) !important;\r\n font-weight: 600 !important;\r\n font-size: 14px !important;\r\n background: transparent !important;\r\n transition: all 0.3s ease !important;\r\n}\r\n\r\n/* Hover State */\r\ndiv.tmenudiv .tmenulabel:hover {\r\n color: var(--brand-primary) !important;\r\n background: rgba(132, 53, 35, 0.08) !important;\r\n transform: translateY(-2px) !important;\r\n}\r\n\r\n/* Active State */\r\ndiv.tmenudiv .tmenulabel.tmenulabelsel {\r\n color: #fff !important;\r\n background: var(--brand-primary) !important;\r\n box-shadow: 0 4px 12px rgba(132, 53, 35, 0.25) !important;\r\n background-image: none !important;\r\n}\r\n\r\n/* ==========================================================================\r\n 3. MODERN SIDEBAR\r\n ========================================================================== */\r\n\r\n/* Main Container */\r\ndiv.side-nav {\r\n background: var(--glass-bg) !important;\r\n backdrop-filter: var(--glass-blur) !important;\r\n border-right: 1px solid rgba(0,0,0,0.05) !important;\r\n box-shadow: 4px 0 24px rgba(0,0,0,0.02) !important;\r\n padding-top: 10px !important;\r\n}\r\n\r\n/* Menu Entries */\r\n.vmenu .vmenuentry {\r\n margin-bottom: 6px !important;\r\n padding: 0 !important;\r\n background: transparent !important;\r\n}\r\n\r\n/* Links inside sidebar */\r\n.vmenu .vmenuentry a.vmenu {\r\n display: block !important;\r\n padding: 12px 20px !important;\r\n border-radius: 0 24px 24px 0 !important;\r\n color: var(--text-muted) !important;\r\n font-weight: 500 !important;\r\n transition: all 0.3s ease !important;\r\n}\r\n\r\n/* Hover */\r\n.vmenu .vmenuentry:hover a.vmenu {\r\n background: rgba(191, 165, 132, 0.15) !important; /* Gold tint */\r\n color: var(--brand-primary) !important;\r\n padding-left: 25px !important; /* Slide effect */\r\n}\r\n\r\n/* Active Sidebar */\r\n.vmenu .vmenuentry.vmenuentrysel a.vmenu {\r\n background: linear-gradient(90deg, var(--brand-primary) 0%, var(--brand-accent) 100%) !important;\r\n color: #fff !important;\r\n font-weight: 700 !important;\r\n box-shadow: 4px 4px 15px rgba(132, 53, 35, 0.2) !important;\r\n}\r\n\r\n/* ==========================================================================\r\n 4. EPIC CARDS (CONTENT CONTAINERS)\r\n ========================================================================== */\r\n\r\n/* Reset borders and backgrounds */\r\ndiv.fiche, div.card, .box, .box-stats {\r\n background: var(--bg-card) !important;\r\n border: none !important;\r\n border-radius: var(--radius-lg) !important;\r\n box-shadow: 0 10px 30px -10px rgba(0,0,0,0.08) !important; /* Soft deep shadow */\r\n margin-bottom: 30px !important;\r\n padding: 30px !important;\r\n}\r\n\r\n/* Hover Lift */\r\ndiv.fiche:hover, .box:hover {\r\n transform: translateY(-5px) !important;\r\n box-shadow: 0 20px 40px -10px rgba(132, 53, 35, 0.15) !important;\r\n}\r\n\r\n/* Titles inside cards */\r\n.box-title, .titre {\r\n text-transform: uppercase !important;\r\n letter-spacing: 1px !important;\r\n font-size: 0.8rem !important;\r\n color: var(--brand-secondary) !important;\r\n font-weight: 800 !important;\r\n border-bottom: 1px solid #eee !important;\r\n padding-bottom: 10px !important;\r\n margin-bottom: 20px !important;\r\n background: transparent !important;\r\n}\r\n\r\n/* ==========================================================================\r\n 5. MODERN \"ODOO-STYLE\" LIST VIEWS (TABLES)\r\n ========================================================================== */\r\n\r\n/* Wrapper */\r\n.div-table-responsive {\r\n border: none !important;\r\n overflow: visible !important; /* Allow hover shadows to show */\r\n}\r\n\r\n/* The Table Itself */\r\ntable.liste {\r\n width: 100% !important;\r\n border-collapse: separate !important;\r\n border-spacing: 0 10px !important; /* Gap between rows */\r\n background: transparent !important;\r\n border: none !important;\r\n}\r\n\r\n/* Header Row */\r\ntable.liste tr.liste_titre {\r\n background: transparent !important;\r\n box-shadow: none !important;\r\n}\r\n\r\ntable.liste tr.liste_titre th, \r\ntable.liste tr.liste_titre td {\r\n background: transparent !important;\r\n border: none !important;\r\n color: var(--text-muted) !important;\r\n font-weight: 700 !important;\r\n text-transform: uppercase !important;\r\n font-size: 11px !important;\r\n padding: 0 15px 10px 15px !important;\r\n}\r\n\r\n/* Data Rows (The Cards) */\r\ntable.liste tr:not(.liste_titre) {\r\n background: #ffffff !important;\r\n box-shadow: 0 2px 5px rgba(0,0,0,0.03) !important;\r\n transition: all 0.2s ease !important;\r\n}\r\n\r\n/* Cells styling */\r\ntable.liste tr:not(.liste_titre) td {\r\n border: none !important; /* KILL ALL BORDERS */\r\n padding: 16px 20px !important;\r\n vertical-align: middle !important;\r\n font-size: 0.95rem !important;\r\n color: var(--text-main) !important;\r\n}\r\n\r\n/* Rounded Corners for Rows */\r\ntable.liste tr:not(.liste_titre) td:first-child {\r\n border-top-left-radius: 12px !important;\r\n border-bottom-left-radius: 12px !important;\r\n}\r\ntable.liste tr:not(.liste_titre) td:last-child {\r\n border-top-right-radius: 12px !important;\r\n border-bottom-right-radius: 12px !important;\r\n}\r\n\r\n/* Row Hover Effect */\r\ntable.liste tr:not(.liste_titre):hover {\r\n background: #FFF8F6 !important; /* Tint warna coklat sangat muda */\r\n transform: scale(1.01) !important;\r\n box-shadow: 0 8px 15px rgba(132, 53, 35, 0.1) !important;\r\n z-index: 2;\r\n position: relative;\r\n}\r\n\r\n/* Remove Zebra Striping */\r\n.pair, .impair {\r\n background: #ffffff !important;\r\n}\r\n\r\n/* Links inside tables */\r\ntable.liste a {\r\n color: var(--text-main) !important;\r\n font-weight: 600 !important;\r\n text-decoration: none !important;\r\n}\r\n\r\n/* ==========================================================================\r\n 6. BUTTONS & INPUTS (INTERACTIVE)\r\n ========================================================================== */\r\n\r\n/* Primary Buttons */\r\n.button, .butAction {\r\n background-image: none !important; /* Hapus gradient bawaan */\r\n background-color: var(--brand-primary) !important;\r\n color: #fff !important;\r\n border: none !important;\r\n border-radius: var(--radius-pill) !important;\r\n padding: 10px 28px !important;\r\n font-weight: 600 !important;\r\n text-transform: uppercase !important;\r\n font-size: 12px !important;\r\n letter-spacing: 0.8px !important;\r\n box-shadow: 0 4px 10px rgba(132, 53, 35, 0.3) !important;\r\n transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1) !important;\r\n}\r\n\r\n.button:hover, .butAction:hover {\r\n background-color: var(--brand-accent) !important;\r\n transform: translateY(-2px) !important;\r\n box-shadow: 0 8px 20px rgba(132, 53, 35, 0.5) !important;\r\n}\r\n\r\n/* Secondary/Refused Buttons */\r\n.buttonRefused, .butActionRefused {\r\n background: transparent !important;\r\n border: 2px solid var(--brand-secondary) !important;\r\n color: var(--brand-secondary) !important;\r\n box-shadow: none !important;\r\n}\r\n\r\n/* Inputs */\r\ninput.flat, textarea.flat, select.flat {\r\n background: #f8fafc !important;\r\n border: 1px solid #e2e8f0 !important;\r\n border-radius: 8px !important;\r\n padding: 10px 12px !important;\r\n box-shadow: none !important;\r\n font-size: 14px !important;\r\n}\r\n\r\ninput.flat:focus, textarea.flat:focus, select.flat:focus {\r\n background: #fff !important;\r\n border-color: var(--brand-primary) !important;\r\n box-shadow: 0 0 0 4px rgba(132, 53, 35, 0.1) !important;\r\n outline: none !important;\r\n}\r\n\r\n/* ==========================================================================\r\n 7. CLEANUP & DETAILS\r\n ========================================================================== */\r\n\r\n/* Hide unwanted separators/images in menu */\r\n.tmenu .mainmenuaspan img { display: none !important; }\r\n\r\n/* Status Badges */\r\n.badge {\r\n border-radius: 6px !important;\r\n paddin
